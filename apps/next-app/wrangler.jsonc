{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mtl-archives-site",
  "account_id": "0bb05130da965c096b12cc1f0637f763",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mtl-archives-site"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "mtl-archives-site-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "mtl_archives_site_events"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://mtl-archives-worker.wiel.workers.dev",
    "NEXT_PUBLIC_R2_PUBLIC_DOMAIN": "pub-6a29793ea7664738880d1cc5afb21b87.r2.dev",
    "NEXT_PUBLIC_SITE_URL": "https://www.mtlarchives.com"
  },
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "MAIL_DB",
      "database_name": "mtl-archives-mail",
      "database_id": "c5bcdaa5-c797-4764-ae85-dd201dd91b78"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "support@support.mtlarchives.com"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "migration.mtlarchives.com",
      "custom_domain": true
    },
    {
      "pattern": "subscribe.mtlarchives.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler",
        "DOShardedTagCache"
      ]
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
