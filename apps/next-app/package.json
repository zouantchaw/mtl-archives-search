{
  "name": "mtl-archives-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke:game": "node ./scripts/smoke-game.mjs",
    "smoke:game:prod": "node ./scripts/smoke-game.mjs https://www.mtlarchives.com/game",
    "smoke:filters": "node ./scripts/smoke-filters.mjs",
    "smoke:filters:prod": "node ./scripts/smoke-filters.mjs https://www.mtlarchives.com/",
    "smoke:filters:mobile": "node ./scripts/smoke-filters-mobile.mjs",
    "smoke:filters:mobile:prod": "node ./scripts/smoke-filters-mobile.mjs https://www.mtlarchives.com/",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --include-runtime=false --env-interface GeneratedCloudflareEnv generated-cloudflare-env.d.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@ai-sdk/react": "^4.0.102",
    "@clerk/localizations": "^3.35.3",
    "@clerk/nextjs": "^6.37.1",
    "@mtl-archives/core": "*",
    "@opennextjs/cloudflare": "1.20.9",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.4",
    "@react-email/render": "^2.0.0",
    "ai": "^7.0.99",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.56.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.148.0"
  }
}
