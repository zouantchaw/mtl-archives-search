{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-h2-builder-external-input-lock-v1",
  "title": "Gate H2 external input lock structure-only schema v1",
  "$comment": "This schema validates transport structure and vocabulary only. verify-external-input-lock.mjs is the sole semantic admission authority, including cross-field joins, category/operation rules, immutability, and accounting.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "runtime_contract", "materializer", "artifacts", "oci_images", "runtime_mapping"],
  "properties": {
    "schema_version": {"const": "gate_h2_builder_external_input_lock_v1.0.0"},
    "platform": {"$ref": "#/$defs/platform"},
    "runtime_contract": {"$ref": "#/$defs/runtimeContract"},
    "materializer": {"$ref": "#/$defs/materializer"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/artifact"}},
    "oci_images": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/ociImage"}},
    "runtime_mapping": {"type": "array", "minItems": 1, "maxItems": 32768, "items": {"$ref": "#/$defs/runtimeMapping"}}
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {"os": {"const": "linux"}, "architecture": {"const": "amd64"}}
    },
    "runtimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_root", "rust", "cargo", "node", "target"],
      "properties": {
        "runtime_root": {"type": "string"}, "rust": {"type": "string"}, "cargo": {"type": "string"},
        "node": {"type": "string"}, "target": {"type": "string"}
      }
    },
    "safePath": {"type": "string", "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "outputIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "bytes", "file_type", "mode"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}, "file_type": {"const": "regular"}, "mode": {"enum": [292, 365]}}
    },
    "materializer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_commit", "source_tree_sha256", "entrypoint"],
      "properties": {"id": {"type": "string", "minLength": 1}, "source_commit": {"$ref": "#/$defs/commit"}, "source_tree_sha256": {"$ref": "#/$defs/sha256"}, "entrypoint": {"type": "string", "minLength": 1}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "kind", "locator"],
      "properties": {"authority": {"type": "string", "minLength": 1}, "kind": {"enum": ["https", "oci"]}, "locator": {"type": "string", "minLength": 1, "maxLength": 2048}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["member_path", "sha256", "bytes", "file_type", "mode", "category", "architecture", "media_type", "archive_format", "source"],
      "allOf": [{"if": {"properties": {"category": {"enum": ["oci_manifest", "oci_config"]}}, "required": ["category"]}, "then": {"properties": {"bytes": {"type": "integer", "maximum": 1048576}}}}],
      "properties": {
        "member_path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "file_type": {"const": "regular"}, "mode": {"const": 292},
        "category": {"enum": ["oci_manifest", "oci_config", "oci_layer", "rust_distribution", "rust_musl_target", "node_distribution", "native_package", "cargo_vendor", "cargo_config", "ca_pem"]},
        "architecture": {"const": "amd64"}, "media_type": {"type": "string", "minLength": 1}, "archive_format": {"anyOf": [{"enum": ["tar", "tar_gzip"]}, {"type": "null"}]}, "source": {"$ref": "#/$defs/source"}
      }
    },
    "ociImage": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "manifest_member_path", "config_member_path", "layer_member_paths"],
      "properties": {
        "reference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"}, "manifest_member_path": {"$ref": "#/$defs/safePath"},
        "config_member_path": {"$ref": "#/$defs/safePath"}, "layer_member_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/safePath"}}
      }
    },
    "runtimeMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["destination", "source_member_path", "operation", "archive_member_path", "output"],
      "properties": {
        "destination": {"type": "string", "maxLength": 98, "pattern": "^/opt/gate-h2/[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*){0,11}$"}, "source_member_path": {"$ref": "#/$defs/safePath"},
        "operation": {"enum": ["archive_member", "whole_file"]}, "archive_member_path": {"anyOf": [{"$ref": "#/$defs/safePath"}, {"type": "null"}]},
        "output": {"$ref": "#/$defs/outputIdentity"}
      }
    }
  }
}
