%% MTL Archives Search - System Architecture
%% Render each section separately in a Mermaid viewer

%% ============================================
%% DIAGRAM 1: ONE-TIME DATA PIPELINE
%% ============================================
%% Copy from "flowchart TB" to the "---" separator

flowchart TB
    subgraph Sources["1. Data Sources"]
        PORTAL[("Montreal Open Data Portal<br/>~15k historical photos")]
        HDD[["Physical Hard Drive<br/>(downloaded images)"]]
    end

    subgraph LocalMachine["2. Local Machine"]
        MANIFEST_RAW[/"manifest_enriched.jsonl<br/>(raw + portal metadata)"/]
        CANONICAL["canonicalize-metadata.ts<br/>normalize + parse"]
        MANIFEST_CANONICAL[/"manifest_canonical.jsonl"/]
        DATES["normalize_dates.py"]
        MANIFEST_DATED[/"manifest_dated.jsonl"/]
        LINK["link-records.ts<br/>rules + BGE"]
        MANIFEST_LINKED[/"manifest_linked.jsonl"/]
        GENSQL["generate-sql.ts"]
        SEED_SQL[/"seed_manifest.sql"/]
    end

    subgraph Vision["3. Vision Enrichment (Offline)"]
        VLM_TAGS["tag-images.ts<br/>Workers AI VLM tags"]
        OCR["ocr-images.py<br/>Tesseract OCR"]
        MERGE["merge-vision-enrichments.ts"]
        MANIFEST_ENRICHED[/"manifest_enriched_v3.jsonl"/]
        SCORE["score-trust.ts"]
        MANIFEST_SCORED[/"manifest_scored.jsonl"/]
    end

    subgraph CLIP["4. CLIP Embedding (GPU/CPU)"]
        CLIP_INGEST["pipelines/vectorize/ingest_clip.py<br/>OpenAI CLIP ViT-B/32<br/>512-dim embeddings"]
    end

    subgraph Scripts["5. Vectorization Scripts"]
        TEXT_INGEST["ingest-text.ts<br/>Workers AI BGE<br/>1024-dim embeddings"]
        EXPORT["export-embeddings.ts<br/>UMAP 2D projection"]
    end

    subgraph CF["6. Cloudflare Storage"]
        R2[("R2<br/>mtl-archives<br/>images")]
        D1[("D1<br/>manifest table")]
        VEC_BGE[("Vectorize<br/>mtl-archives<br/>1024-dim")]
        VEC_CLIP[("Vectorize<br/>mtl-archives-clip<br/>512-dim")]
        R2_EMB[("R2<br/>embedding files")]
    end

    %% Flow
    PORTAL -->|download| MANIFEST_RAW
    PORTAL -->|download| HDD
    HDD -->|"wrangler r2 object put"| R2

    MANIFEST_RAW --> CANONICAL --> MANIFEST_CANONICAL --> DATES --> MANIFEST_DATED --> LINK --> MANIFEST_LINKED

    MANIFEST_LINKED --> VLM_TAGS
    MANIFEST_LINKED --> OCR
    VLM_TAGS --> MERGE
    OCR --> MERGE
    MERGE --> MANIFEST_ENRICHED --> SCORE --> MANIFEST_SCORED

    MANIFEST_LINKED --> GENSQL --> SEED_SQL
    SEED_SQL -->|"wrangler d1 execute"| D1

    MANIFEST_ENRICHED --> TEXT_INGEST
    TEXT_INGEST --> VEC_BGE

    MANIFEST_LINKED --> CLIP_INGEST
    R2 -.->|fetch images| CLIP_INGEST
    CLIP_INGEST --> VEC_CLIP

    VEC_CLIP --> EXPORT --> R2_EMB
