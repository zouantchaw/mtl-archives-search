{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtlarchives.com/schemas/canonical-corpus-alias.v1.json",
  "title": "Canonical Corpus v1 alias row",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "alias_identity", "canonical_identity", "source_identity", "basis", "alias_systems", "canonical_systems", "payload_etag_match"],
  "properties": {
    "schema_version": { "const": "canonical_corpus_v1.0.0" },
    "alias_identity": { "type": "string", "pattern": "^mtl_archives_metadata_[0-9]+\\.json$" },
    "canonical_identity": { "type": "string", "pattern": "^mtl_archives_metadata_[0-9]+\\.json$" },
    "source_identity": { "type": "string", "minLength": 1 },
    "basis": { "const": "exact_source_identity_single_d1_member" },
    "alias_systems": { "$ref": "#/$defs/systems" },
    "canonical_systems": { "$ref": "#/$defs/systems" },
    "payload_etag_match": { "type": ["boolean", "null"] }
  },
  "$defs": {
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "d1", "r2", "text_vector", "clip_vector"],
      "properties": {
        "local": { "type": "boolean" },
        "d1": { "type": "boolean" },
        "r2": { "type": "boolean" },
        "text_vector": { "type": "boolean" },
        "clip_vector": { "type": "boolean" }
      }
    }
  }
}
