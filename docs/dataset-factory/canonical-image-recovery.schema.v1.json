{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtlarchives.com/schemas/canonical-image-recovery.v1.json",
  "title": "Canonical Image Recovery v1 row",
  "type": "object",
  "required": ["schema_version", "recovery_contract_id", "baseline_failure_stream_sha256", "corpus_input_sha256", "record_id", "attempted_lanes", "root_cause", "root_cause_evidence", "disposition", "recovered", "negative_visual_label"],
  "properties": {
    "schema_version": { "const": "canonical_image_recovery_v1.0.0" },
    "recovery_contract_id": { "type": "string", "pattern": "^canonical-image-recovery-contract:[a-f0-9]{64}$" },
    "baseline_failure_stream_sha256": { "const": "62f266e28e26fe97d03c5bc17169e319f70a2ab07f7d87c4a5eaeb0bea4f046b" },
    "corpus_input_sha256": { "const": "0f9971c70ac242c44ee80835b4c71e9f771e742d8c80603cf39bc1163cc951cc" },
    "record_id": { "type": "string", "pattern": "^mtl_archives_metadata_[0-9]+\\.json$" },
    "attempted_lanes": { "type": "array", "minItems": 1 },
    "root_cause": { "enum": ["transient_thumbnail_api_failure", "incorrect_or_stale_image_key", "r2_object_absent", "source_object_reachable_but_r2_derivative_unavailable", "unsupported_non_image_payload", "corrupt_or_undecodable_image", "bounded_response_size_failure", "source_archive_unavailable", "rights_or_access_blocked", "indeterminate"] },
    "disposition": { "enum": ["recovered_public_r2", "recovered_alias", "recovered_authoritative_source", "reviewed_unavailable", "indeterminate", "held_over_contract"] },
    "recovered": { "type": "boolean" },
    "negative_visual_label": { "const": false }
  },
  "additionalProperties": true
}
