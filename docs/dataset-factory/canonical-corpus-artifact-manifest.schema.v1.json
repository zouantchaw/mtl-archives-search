{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtlarchives.com/schemas/canonical-corpus-artifact-manifest.v1.json",
  "title": "Canonical Corpus v1 artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_version", "artifact_manifest_version", "source_snapshot_id", "lineage", "artifacts", "arithmetic"],
  "properties": {
    "schema_version": { "const": "canonical_corpus_v1.0.0" },
    "corpus_version": { "const": "canonical_corpus_v1" },
    "artifact_manifest_version": { "const": "canonical_corpus_artifact_manifest_v1" },
    "source_snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "inputs", "build_command", "code_ref"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array", "minItems": 12, "maxItems": 12,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/file" },
              { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["json", "jsonl"] } } }
            ]
          }
        },
        "build_command": { "type": "string", "minLength": 1 },
        "code_ref": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/file" },
          {
            "type": "object", "required": ["schema_version"],
            "properties": { "schema_version": { "type": "string", "minLength": 1 } }
          }
        ]
      }
    },
    "arithmetic": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_identity_rows", "state_total", "corpus_rows", "unresolved_rows", "alias_rows"],
      "properties": {
        "observed_identity_rows": { "type": "integer", "minimum": 0 },
        "state_total": { "type": "integer", "minimum": 0 },
        "corpus_rows": { "type": "integer", "minimum": 0 },
        "unresolved_rows": { "type": "integer", "minimum": 0 },
        "alias_rows": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byte_count": { "type": "integer", "minimum": 0 },
        "row_count": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["json", "jsonl"] },
        "schema_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
