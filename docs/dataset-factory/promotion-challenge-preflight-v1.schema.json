{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtlarchives.com/schemas/promotion-challenge-preflight-v1.schema.json",
  "title": "MTL CityMemory promotion challenge preflight v1",
  "description": "A pre-Benchmark-v1 no-ship scaffold. It cannot represent a model run, benchmark result, promotion, or production authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preflight_id", "generated_at", "decision", "ship_authority", "scope", "benchmark_v1", "challenge_execution", "gates", "blockers", "next_steps"],
  "properties": {
    "schema_version": { "const": "mtl_citymemory_promotion_challenge_preflight_v1.0.0" },
    "preflight_id": { "const": "mtl_citymemory_promotion_challenge_v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "decision": { "const": "no_ship" },
    "ship_authority": { "const": false },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["issue", "benchmark_id", "mode"],
      "properties": { "issue": { "const": 71 }, "benchmark_id": { "const": "mtl_citymemory_bench_v1" }, "mode": { "const": "pre_lock_scaffold" } }
    },
    "benchmark_v1": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_report", "issue_70_complete", "lock_authority"],
      "properties": {
        "candidate_report": {
          "type": "object", "additionalProperties": false,
          "required": ["locator", "status", "sha256"],
          "properties": {
            "locator": { "type": "string", "minLength": 1 },
            "status": { "enum": ["available", "missing", "invalid"] },
            "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "issue_70_complete": { "const": false },
        "lock_authority": { "const": false }
      }
    },
    "challenge_execution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "model_runs", "gpu_runs", "production_runs", "results_consumed"],
      "properties": {
        "status": { "const": "not_run" },
        "model_runs": { "const": 0 },
        "gpu_runs": { "const": 0 },
        "production_runs": { "const": 0 },
        "results_consumed": { "const": false }
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "status", "reason"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "blocked", "not_provided"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "next_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
