{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://mtlarchives.com/schemas/verified-multimodal-benchmark-task-v1.json", "title": "Verified Multimodal Benchmark Task v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "record_id", "lane", "query", "positive_claim_ids", "positive_record_ids", "evidence_boundary", "source_urls", "family_id", "component_id", "split", "source_snapshot_digest"],
  "properties": {
    "schema_version": { "const": "verified_multimodal_benchmark_task_v1.0.0" }, "task_id": { "$ref": "#/$defs/nonblank" }, "record_id": { "$ref": "#/$defs/nonblank" }, "lane": { "enum": ["ground_ocr_entity_place", "aerial_land_use_georeference"] }, "query": { "$ref": "#/$defs/nonblank" },
    "positive_claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonblank" } }, "positive_record_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonblank" } }, "evidence_boundary": { "const": "externally_verified" },
    "source_urls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://[^?#]+$" } }, "family_id": { "$ref": "#/$defs/nonblank" }, "component_id": { "$ref": "#/$defs/nonblank" }, "split": { "enum": ["train", "validation", "test"] }, "source_snapshot_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }, "$defs": { "nonblank": { "type": "string", "pattern": "\\S" } }
}
