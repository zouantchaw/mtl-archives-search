{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://mtlarchives.com/schemas/verified-multimodal-run-report-v1.json", "title": "Verified Multimodal Intelligence Run Report v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "batch_id", "generated_at", "scope", "acceptance_target_records", "processed_records", "fully_verified_dossiers", "foundation_incomplete", "packet_sha256", "benchmark_sha256", "unresolved_sha256", "rejected_sha256", "counts", "gates", "hard_controls", "gaps", "recommended_next_slice"],
  "properties": {
    "schema_version": { "const": "verified_multimodal_run_report_v1.0.0" }, "batch_id": { "const": "verified_multimodal_batch_001" }, "generated_at": { "type": "string", "format": "date-time" }, "scope": { "const": "synthetic_hermetic_pilot" }, "acceptance_target_records": { "const": 60 },
    "processed_records": { "type": "integer", "minimum": 0 }, "fully_verified_dossiers": { "const": 0 }, "foundation_incomplete": { "const": true },
    "packet_sha256": { "$ref": "#/$defs/digest" }, "benchmark_sha256": { "$ref": "#/$defs/digest" }, "unresolved_sha256": { "$ref": "#/$defs/digest" }, "rejected_sha256": { "$ref": "#/$defs/digest" },
    "counts": { "type": "object", "additionalProperties": false, "required": ["lanes", "accepted_claims", "unresolved_claims", "rejected_claims", "benchmark_tasks", "abstentions"], "properties": { "lanes": { "type": "object", "additionalProperties": false, "required": ["ground_ocr_entity_place", "aerial_land_use_georeference"], "properties": { "ground_ocr_entity_place": { "type": "integer", "minimum": 0 }, "aerial_land_use_georeference": { "type": "integer", "minimum": 0 } } }, "accepted_claims": { "type": "integer", "minimum": 0 }, "unresolved_claims": { "type": "integer", "minimum": 0 }, "rejected_claims": { "type": "integer", "minimum": 0 }, "benchmark_tasks": { "const": 0 }, "abstentions": { "type": "integer", "minimum": 0 } } },
    "gates": { "type": "object", "additionalProperties": false, "required": ["visual_regions", "external_source_url_and_note", "rights_completeness", "confidence_and_verified_status", "exact_location_evidence", "scale_georeference_for_area_distance", "reviewer_independence", "accepted_evidence_only_benchmark"], "properties": { "visual_regions": { "const": "passed" }, "external_source_url_and_note": { "const": "passed" }, "rights_completeness": { "const": "passed" }, "confidence_and_verified_status": { "const": "passed" }, "exact_location_evidence": { "const": "passed" }, "scale_georeference_for_area_distance": { "const": "passed" }, "reviewer_independence": { "const": "passed" }, "accepted_evidence_only_benchmark": { "const": "passed" } } },
    "hard_controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonblank" } }, "gaps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonblank" } }, "recommended_next_slice": { "$ref": "#/$defs/nonblank" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "nonblank": { "type": "string", "pattern": "\\S" } }
}
