{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtlarchives.com/schemas/verified-multimodal-run-report-v1.json",
  "title": "Verified Multimodal Intelligence Run Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "generated_at",
    "scope",
    "acceptance_target_records",
    "processed_records",
    "fully_verified_dossiers",
    "foundation_incomplete",
    "packet_sha256",
    "benchmark_sha256",
    "unresolved_sha256",
    "rejected_sha256",
    "counts",
    "gates",
    "hard_controls",
    "gaps",
    "recommended_next_slice"
  ],
  "properties": {
    "schema_version": { "const": "verified_multimodal_run_report_v1.0.0" },
    "batch_id": { "const": "verified_multimodal_batch_001" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scope": { "const": "synthetic_hermetic_pilot" },
    "acceptance_target_records": { "const": 60 },
    "processed_records": { "type": "integer", "minimum": 0 },
    "fully_verified_dossiers": { "type": "integer", "minimum": 0 },
    "foundation_incomplete": { "const": true },
    "packet_sha256": { "pattern": "^[a-f0-9]{64}$" },
    "benchmark_sha256": { "pattern": "^[a-f0-9]{64}$" },
    "unresolved_sha256": { "pattern": "^[a-f0-9]{64}$" },
    "rejected_sha256": { "pattern": "^[a-f0-9]{64}$" },
    "counts": { "type": "object" },
    "gates": { "type": "object" },
    "hard_controls": { "type": "array", "items": { "type": "string" } },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "recommended_next_slice": { "type": "string", "minLength": 1 }
  }
}
