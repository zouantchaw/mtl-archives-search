{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtlarchives.com/schemas/verified-multimodal-packet-v1.json",
  "title": "Verified Multimodal Intelligence Packet v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "batch_id",
    "pilot_scope",
    "record_id",
    "lane",
    "source_metadata",
    "rights_attribution",
    "regions",
    "evidence",
    "visual_observations",
    "source_metadata_claims",
    "inferred_hypotheses",
    "externally_verified_claims",
    "rejected_hypotheses",
    "abstentions",
    "review_state"
  ],
  "properties": {
    "schema_version": { "const": "verified_multimodal_packet_v1.0.0" },
    "batch_id": { "const": "verified_multimodal_batch_001" },
    "pilot_scope": { "const": "synthetic_hermetic_foundation" },
    "synthetic_fixture": { "const": true },
    "lane": { "enum": ["ground_ocr_entity_place", "aerial_land_use_georeference"] },
    "record_id": { "type": "string", "minLength": 1 },
    "source_metadata": { "type": "object" },
    "rights_attribution": { "type": "object" },
    "regions": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 1 },
    "visual_observations": { "type": "array" },
    "source_metadata_claims": { "type": "array" },
    "inferred_hypotheses": { "type": "array" },
    "externally_verified_claims": { "type": "array" },
    "rejected_hypotheses": { "type": "array" },
    "abstentions": { "type": "array" },
    "review_state": { "type": "object" }
  }
}
