{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "independent-source-authority-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "status", "reviewer", "reviewed_at", "required_attestations", "attestations", "bindings", "dispositions"],
  "properties": {
    "schema_version": { "const": "aerial_source_authority_receipt_v1.0.0" },
    "artifact_id": { "const": "aerial-source-evidence-v1" },
    "status": { "const": "completed" },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "required_attestations": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "attestations": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "bindings": { "type": "object" },
    "dispositions": { "type": "array", "minItems": 22, "maxItems": 22, "items": { "$ref": "#/$defs/disposition" } }
  },
  "$defs": {
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_id", "session_id", "model", "reasoning_effort", "reviewed_at", "independent_of"],
      "properties": { "reviewer_id": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 }, "model": { "const": "gpt-5.6-sol" }, "reasoning_effort": { "const": "high" }, "reviewed_at": { "type": "string", "format": "date-time" }, "independent_of": { "const": ["implementation", "acquisition", "dossier_review"] } }
    },
    "disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["numeric_id", "evidence_disposition", "accepted_proposition_ids", "location", "georef", "scale", "land_use", "measurement", "georeference_proposal", "accepted_claims", "verified_dossiers", "tasks", "rationale"],
      "properties": { "numeric_id": { "type": "integer" }, "evidence_disposition": { "const": "accepted" }, "accepted_proposition_ids": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string" } }, "location": { "enum": ["held", "abstained"] }, "georef": { "enum": ["held", "abstained"] }, "scale": { "enum": ["held", "abstained"] }, "land_use": { "enum": ["held", "abstained"] }, "measurement": { "enum": ["held", "abstained"] }, "georeference_proposal": { "type": "null" }, "accepted_claims": { "const": 0 }, "verified_dossiers": { "const": 0 }, "tasks": { "const": 0 }, "rationale": { "type": "string", "minLength": 1 } }
    }
  }
}
