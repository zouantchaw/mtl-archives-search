{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["stable_id", "schema_version", "artifact_schema_version", "artifact_kind", "content_digest", "counts", "source_lineage", "storage", "generation", "dependency_ids", "required_by", "rights_boundary", "created_at", "creation_time_basis"],
  "properties": {
    "stable_id": { "const": "dfv0_aerial_source_evidence_v1_authority" },
    "schema_version": { "const": "dataset_factory_artifact_registry_v0" },
    "artifact_schema_version": { "const": "aerial_source_evidence_authority_v1.0.0" },
    "artifact_kind": { "const": "directory" },
    "content_digest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value", "scope"], "properties": { "algorithm": { "const": "sha256" }, "value": { "$ref": "#/$defs/hash" }, "scope": { "const": "final_descriptor_tree" } } },
    "counts": { "$ref": "#/$defs/counts" },
    "source_lineage": { "type": "object", "additionalProperties": false, "required": ["description", "source_artifact_ids", "source_urls"], "properties": { "description": { "const": "Issue #90 externally reviewed source/media/rights/attribution evidence with semantic abstentions preserved." }, "source_artifact_ids": { "const": ["dfv0_aerial_source_evidence_v1_candidate"] }, "source_urls": { "const": ["https://github.com/zouantchaw/mtl-archives-search/issues/90"] } } },
    "storage": { "type": "object", "additionalProperties": false, "required": ["storage_class", "path_class", "locator"], "properties": { "storage_class": { "const": "external_publication_output" }, "path_class": { "const": "coordinator_selected" }, "locator": { "type": "string", "minLength": 1 } } },
    "generation": { "type": "object", "additionalProperties": false, "required": ["method", "command", "code_ref", "human_input_ids"], "properties": { "method": { "const": "external_review_receipt" }, "command": { "const": "npm run dataset-factory:aerial-authority-v1 -- publish" }, "code_ref": { "const": "codex/90-aerial-source-evidence" }, "human_input_ids": { "const": [] } } },
    "dependency_ids": { "const": ["dfv0_aerial_source_evidence_v1_candidate"] },
    "required_by": { "const": ["issue #90 Gate F"] },
    "rights_boundary": { "type": "object", "additionalProperties": false, "required": ["license_id", "attribution", "commercial_use_allowed", "notes"], "properties": { "license_id": { "const": "cc-by-4.0" }, "attribution": { "const": "Archives de la Ville de Montréal" }, "commercial_use_allowed": { "const": true }, "notes": { "const": "Source/media/rights/attribution authority only; location, georef, scale, land use, and measurement remain held or abstained." } } },
    "created_at": { "type": "string", "format": "date-time" },
    "creation_time_basis": { "const": "external_review_receipt" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "counts": { "type": "object", "additionalProperties": false, "required": ["file_count", "byte_count", "records", "accepted_evidence", "held_evidence", "rejected_evidence", "accepted_claims", "verified_dossiers", "tasks", "location", "georef", "scale", "land_use", "measurement"], "properties": { "file_count": { "const": 15 }, "byte_count": { "type": "integer", "minimum": 1 }, "records": { "const": 22 }, "accepted_evidence": { "const": 22 }, "held_evidence": { "const": 0 }, "rejected_evidence": { "const": 0 }, "accepted_claims": { "const": 0 }, "verified_dossiers": { "const": 0 }, "tasks": { "const": 0 }, "location": { "const": 0 }, "georef": { "const": 0 }, "scale": { "const": 0 }, "land_use": { "const": 0 }, "measurement": { "const": 0 } } }
  }
}
