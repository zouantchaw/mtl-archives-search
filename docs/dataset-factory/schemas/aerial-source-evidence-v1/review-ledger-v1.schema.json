{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "authority_receipt", "reviewer", "dispositions", "counts"],
  "properties": {
    "schema_version": { "const": "aerial_source_evidence_authority_v1.0.0" },
    "artifact_id": { "const": "aerial-source-evidence-v1" },
    "authority_receipt": { "$ref": "#/$defs/binding" },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "dispositions": { "type": "array", "minItems": 22, "maxItems": 22, "items": { "$ref": "#/$defs/disposition" } },
    "counts": { "$ref": "#/$defs/counts" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "binding": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "const": "independent-source-authority-receipt-v1.json" }, "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/hash" } } },
    "reviewer": { "type": "object", "additionalProperties": false, "required": ["reviewer_id", "session_id", "model", "reasoning_effort", "reviewed_at", "independent_of"], "properties": { "reviewer_id": { "type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\r\\n]*\\S)?$" }, "session_id": { "type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\r\\n]*\\S)?$" }, "model": { "const": "gpt-5.6-sol" }, "reasoning_effort": { "const": "high" }, "reviewed_at": { "type": "string", "format": "date-time" }, "independent_of": { "const": ["implementation", "acquisition", "dossier_review"] } } },
    "disposition": { "type": "object", "additionalProperties": false, "required": ["numeric_id", "evidence_disposition", "accepted_proposition_ids", "location", "georef", "scale", "land_use", "measurement", "georeference_proposal", "accepted_claims", "verified_dossiers", "tasks", "rationale"], "properties": { "numeric_id": { "enum": [8132, 8134, 8139, 8143, 12115, 11923, 4501, 14135, 12623, 7929, 9844, 9092, 13389, 14965, 11836, 11993, 8432, 13272, 14813, 12117, 10153, 9504] }, "evidence_disposition": { "const": "accepted" }, "accepted_proposition_ids": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "location": { "enum": ["held", "abstained"] }, "georef": { "enum": ["held", "abstained"] }, "scale": { "enum": ["held", "abstained"] }, "land_use": { "enum": ["held", "abstained"] }, "measurement": { "enum": ["held", "abstained"] }, "georeference_proposal": { "type": "null" }, "accepted_claims": { "const": 0 }, "verified_dossiers": { "const": 0 }, "tasks": { "const": 0 }, "rationale": { "type": "string", "minLength": 1 } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["records", "accepted_evidence", "held_evidence", "rejected_evidence", "accepted_claims", "verified_dossiers", "tasks", "location", "georef", "scale", "land_use", "measurement"], "properties": { "records": { "const": 22 }, "accepted_evidence": { "const": 22 }, "held_evidence": { "const": 0 }, "rejected_evidence": { "const": 0 }, "accepted_claims": { "const": 0 }, "verified_dossiers": { "const": 0 }, "tasks": { "const": 0 }, "location": { "const": 0 }, "georef": { "const": 0 }, "scale": { "const": 0 }, "land_use": { "const": 0 }, "measurement": { "const": 0 } } }
  }
}
