{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "numeric_id",
        "component_id",
        "split",
        "phase_d_selection_index",
        "stratum"
      ],
      "properties": {
        "record_id": { "type": "string" },
        "numeric_id": { "type": "integer" },
        "component_id": { "type": "string" },
        "split": { "type": "string" },
        "phase_d_selection_index": { "type": "integer" },
        "stratum": { "enum": ["aerial", "ground"] }
      }
    },
    "reviewer": {
      "$ref": "completed-independent-review.schema.v1.json#/$defs/reviewer"
    },
    "approvals": {
      "$ref": "completed-independent-review.schema.v1.json#/$defs/approvals"
    },
    "publishedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "completed",
        "reviewer",
        "disposition",
        "approvals",
        "rationale"
      ],
      "properties": {
        "required": { "const": true },
        "completed": { "const": true },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "disposition": { "enum": ["accepted", "held", "rejected"] },
        "approvals": { "$ref": "#/$defs/approvals" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_candidate_artifact_id", "dossiers"],
  "properties": {
    "schema_version": { "const": "verified_dossiers_publication_v1.0.0" },
    "source_candidate_artifact_id": { "type": "string" },
    "dossiers": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "dossier_id",
          "state",
          "fully_verified",
          "source_acquisition_only",
          "publication_eligible",
          "expected_review_disposition",
          "record",
          "predecessors",
          "review_pixels",
          "rights",
          "archive_metadata",
          "visual_claims",
          "external_claims",
          "alternatives",
          "contradictions",
          "uncertainty",
          "author",
          "independent_review"
        ],
        "properties": {
          "schema_version": { "const": "verified_dossiers_v1.0.0" },
          "dossier_id": { "type": "string" },
          "state": {
            "enum": [
              "published_independently_verified",
              "retained_held",
              "retained_rejected"
            ]
          },
          "fully_verified": { "type": "boolean" },
          "source_acquisition_only": { "const": false },
          "publication_eligible": { "type": "boolean" },
          "expected_review_disposition": {
            "enum": ["held", "independent_review_required"]
          },
          "record": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/packet/properties/record"
          },
          "predecessors": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/predecessors"
          },
          "review_pixels": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/packet/properties/review_pixels"
          },
          "rights": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/rights"
          },
          "archive_metadata": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/packet/properties/archive_metadata"
          },
          "visual_claims": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/packet/properties/visual_claims"
          },
          "external_claims": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/packet/properties/external_claims"
          },
          "alternatives": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/packet/properties/alternatives"
          },
          "contradictions": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/packet/properties/contradictions"
          },
          "uncertainty": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/packet/properties/uncertainty"
          },
          "author": {
            "$ref": "candidate-packets.schema.v1.json#/$defs/packet/properties/author"
          },
          "independent_review": { "$ref": "#/$defs/publishedReview" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "independent_review": {
                  "properties": { "disposition": { "const": "accepted" } },
                  "required": ["disposition"]
                }
              },
              "required": ["independent_review"]
            },
            "then": {
              "properties": {
                "state": { "const": "published_independently_verified" },
                "fully_verified": { "const": true },
                "publication_eligible": { "const": true }
              }
            }
          },
          {
            "if": {
              "properties": {
                "independent_review": {
                  "properties": { "disposition": { "const": "held" } },
                  "required": ["disposition"]
                }
              },
              "required": ["independent_review"]
            },
            "then": {
              "properties": {
                "state": { "const": "retained_held" },
                "fully_verified": { "const": false }
              }
            }
          },
          {
            "if": {
              "properties": {
                "independent_review": {
                  "properties": { "disposition": { "const": "rejected" } },
                  "required": ["disposition"]
                }
              },
              "required": ["independent_review"]
            },
            "then": {
              "properties": {
                "state": { "const": "retained_rejected" },
                "fully_verified": { "const": false }
              }
            }
          },
          {
            "if": {
              "properties": { "publication_eligible": { "const": false } },
              "required": ["publication_eligible"]
            },
            "then": {
              "properties": {
                "fully_verified": { "const": false },
                "independent_review": {
                  "properties": {
                    "disposition": { "enum": ["held", "rejected"] }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
