{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "stage", "status", "reviewer", "reviewed_at", "independence_attestations", "bindings", "dispositions"],
  "properties": {
    "schema_version": { "const": "reviewed_source_evidence_v1.0.0" },
    "artifact_id": { "const": "reviewed-source-evidence-v1" },
    "stage": { "const": "independent_source_body_review" },
    "status": { "const": "completed" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "review_session_id", "role", "model_route"],
      "properties": {
        "identity": { "type": "string", "minLength": 8 },
        "review_session_id": { "type": "string", "minLength": 8 },
        "role": { "const": "independent_source_body_reviewer" },
        "model_route": { "const": "sol_high" }
      }
    },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "independence_attestations": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 20 } },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquisition_manifest_sha256", "representations_sha256", "review_input_sha256", "external_snapshot_sha256", "external_snapshot_bytes", "external_snapshot_storage_receipt_sha256", "candidate_descriptor_sha256", "candidate_tree_sha256", "claims", "representations", "rights", "predecessor_pins"],
      "properties": {
        "acquisition_manifest_sha256": { "$ref": "#/$defs/hash" },
        "representations_sha256": { "$ref": "#/$defs/hash" },
        "review_input_sha256": { "$ref": "#/$defs/hash" },
        "external_snapshot_sha256": { "$ref": "#/$defs/hash" },
        "external_snapshot_bytes": { "type": "integer", "minimum": 1 },
        "external_snapshot_storage_receipt_sha256": { "$ref": "#/$defs/hash" },
        "candidate_descriptor_sha256": { "$ref": "#/$defs/hash" },
        "candidate_tree_sha256": { "$ref": "#/$defs/hash" },
        "claims": { "type": "array", "minItems": 7, "maxItems": 7 },
        "representations": { "type": "array", "minItems": 12, "maxItems": 12 },
        "rights": { "type": "array", "minItems": 4, "maxItems": 4 },
        "predecessor_pins": { "type": "array", "minItems": 8, "maxItems": 8 }
      }
    },
    "dispositions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "disposition", "complete_claim_wording_supported", "supported_source_representation_ids", "supported_proposition_ids", "rationale", "limitations"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^c[0-9]+-[a-z0-9-]+$" },
          "disposition": { "enum": ["accepted", "held", "rejected", "abstained"] },
          "complete_claim_wording_supported": { "type": "boolean" },
          "supported_source_representation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^repr-r" } },
          "supported_proposition_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^p-c" } },
          "rationale": { "type": "string", "minLength": 10 },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
        }
      }
    }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
