{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-execution-ledger.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "candidate_commit", "authority_hash", "ledger_root_commitment", "stage_count", "stages"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_stage_execution_ledger_evidence_v2.0.0" },
    "candidate_id": { "const": "dfv0_reviewed_metrics_v2_candidate_20260715" },
    "candidate_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "authority_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ledger_root_commitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stage_count": { "const": 12 },
    "stages": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "role", "invocation_commitment", "nonce_commitment", "physical_host_commitment", "receipt_sha256", "receipt_signature_sha256", "begin_marker_sha256", "completion_marker_sha256", "command_started_at", "command_completed_at", "outputs"],
        "properties": {
          "stage_id": { "enum": ["visual_predict", "visual_freeze", "source_predict", "source_freeze", "gold_review", "gold_envelope_authoring", "private_prepare", "r2_retain", "private_finalize", "task_review", "metrics_score", "publication"] },
          "role": { "enum": ["predictor", "search_predictor", "gold_reviewer", "private_evaluator", "task_reviewer", "publisher"] },
          "invocation_commitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "nonce_commitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "physical_host_commitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "receipt_signature_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "begin_marker_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "completion_marker_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "command_started_at": { "type": "string", "format": "date-time" },
          "command_completed_at": { "type": "string", "format": "date-time" },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_role", "sha256", "bytes"],
              "properties": {
                "artifact_role": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "bytes": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
