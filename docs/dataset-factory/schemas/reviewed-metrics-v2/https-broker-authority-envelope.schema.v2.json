{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https-broker-authority-envelope.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_pin",
    "envelope_id",
    "transcript_id",
    "transcript_sha256",
    "manifest_id",
    "d1_attempt_id",
    "d1_begin_sha256",
    "session_id",
    "attempt_id",
    "broker_binary",
    "stage_runtime",
    "trust_roots",
    "socket_identity_sha256",
    "run_token_commitment",
    "final_outcome",
    "signer_id",
    "signer_trust_entry_sha256",
    "public_key_base64url",
    "signature_algorithm",
    "signature_base64url"
  ],
  "properties": {
    "schema_version": { "const": "gate_h2_https_broker_authority_envelope_v2.0.0" },
    "schema_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "schema_version"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "schema_version": { "const": "gate_h2_https_broker_authority_envelope_v2.0.0" }
      }
    },
    "envelope_id": { "$ref": "#/$defs/sha256" },
    "transcript_id": { "$ref": "#/$defs/sha256" },
    "transcript_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_id": { "$ref": "#/$defs/sha256" },
    "d1_attempt_id": { "$ref": "#/$defs/identifier" },
    "d1_begin_sha256": { "$ref": "#/$defs/sha256" },
    "session_id": { "$ref": "#/$defs/identifier" },
    "attempt_id": { "$ref": "#/$defs/identifier" },
    "broker_binary": { "$ref": "#/$defs/filePin" },
    "stage_runtime": { "$ref": "#/$defs/filePin" },
    "trust_roots": { "$ref": "#/$defs/filePin" },
    "socket_identity_sha256": { "$ref": "#/$defs/sha256" },
    "run_token_commitment": { "$ref": "#/$defs/sha256" },
    "final_outcome": { "enum": ["complete", "failed_closed"] },
    "signer_id": { "$ref": "#/$defs/sha256" },
    "signer_trust_entry_sha256": { "$ref": "#/$defs/sha256" },
    "public_key_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "signature_algorithm": { "const": "ed25519" },
    "signature_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "version"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
