{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "linux-sandbox-attestation.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "synthetic", "platform", "wrapper", "image", "runtime_tree", "executor_semantics", "wrapper_grammar_version", "fixed_argument_allowlist", "argv_prefix", "mounts", "network", "writable_confinement", "repo_tree_sha256", "observation", "signer", "signature_base64"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_linux_sandbox_attestation_v2.3.0" },
    "status": { "const": "observed_live_enforced" },
    "synthetic": { "const": false },
    "platform": { "const": "linux" },
    "wrapper": { "$ref": "#/$defs/filePin" },
    "image": { "type": "object", "additionalProperties": false, "required": ["identity_kind", "immutable_identity", "digest"], "properties": { "identity_kind": { "enum": ["oci_manifest", "ami", "vm_image"] }, "immutable_identity": { "type": "string", "minLength": 16 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } },
    "runtime_tree": { "type": "object", "additionalProperties": false, "required": ["runtime", "resolution_contract", "physical_roots", "members", "complete_tree_sha256", "complete_tree_bytes", "member_count", "enumeration_contract"], "properties": { "runtime": { "$ref": "#/$defs/filePin" }, "resolution_contract": { "$ref": "installed-dependency-tree.schema.v2.json#/$defs/resolutionContract" }, "physical_roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/physicalRoot" } }, "members": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/filePin" } }, "complete_tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "complete_tree_bytes": { "type": "integer", "minimum": 1 }, "member_count": { "type": "integer", "minimum": 4 }, "enumeration_contract": { "const": "sorted_physical_regular_files_path_sha256_bytes_v2" } } },
    "executor_semantics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/executorSemanticsBundle" } },
    "wrapper_grammar_version": { "const": "gate_h2_linux_wrapper_argv_v3" },
    "fixed_argument_allowlist": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["allowlist_id", "scalar_type", "allowed_values", "value", "value_sha256"], "properties": { "allowlist_id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "scalar_type": { "enum": ["enum", "integer", "sha256", "identifier", "boolean"] }, "allowed_values": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "value": { "type": "string", "minLength": 1 }, "value_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "argv_prefix": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["index", "argument_kind", "value", "value_sha256", "semantic_role", "source_ref", "semantic_fields", "semantic_join_sha256"], "properties": { "index": { "type": "integer", "minimum": 0 }, "argument_kind": { "enum": ["derived", "fixed"] }, "value": { "type": "string", "minLength": 1 }, "value_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "semantic_role": { "enum": ["image_identity", "read_only_mount", "output_mount", "network_boundary", "runtime_entrypoint", "destination_capability", "fixed_scalar"] }, "source_ref": { "type": "string", "pattern": "^[a-z0-9_:-]+$" }, "semantic_fields": { "type": "object" }, "semantic_join_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "mounts": { "type": "object", "additionalProperties": false, "required": ["readable_inputs", "output_mounts"], "properties": { "readable_inputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/mount" } }, "output_mounts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/mount" } } } },
    "network": { "type": "object", "additionalProperties": false, "required": ["namespace_identity_sha256", "firewall_rules_sha256", "policy", "destination_capability_ids", "observed_destinations_digest"], "properties": { "namespace_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "firewall_rules_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "policy": { "enum": ["deny_all", "allow_capabilities_only"] }, "destination_capability_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "observed_destinations_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "writable_confinement": { "type": "object", "additionalProperties": false, "required": ["writable_paths", "read_only_root", "pre_state_sha256", "post_state_sha256", "enforcement_evidence_sha256"], "properties": { "writable_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } }, "read_only_root": { "const": true }, "pre_state_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "post_state_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "enforcement_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "repo_tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observation": { "$ref": "#/$defs/identity" },
    "signer": { "$ref": "#/$defs/signer" },
    "signature_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "$defs": {
    "filePin": { "type": "object", "additionalProperties": false, "required": ["path", "realpath", "sha256", "bytes", "version"], "properties": { "path": { "type": "string", "pattern": "^/" }, "realpath": { "type": "string", "pattern": "^/" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "physicalRoot": { "type": "object", "additionalProperties": false, "required": ["path", "realpath", "discovery_rule"], "properties": { "path": { "type": "string", "pattern": "^/" }, "realpath": { "type": "string", "pattern": "^/" }, "discovery_rule": { "const": "recursive_regular_files_no_symlinks_v1" } } },
    "mount": { "type": "object", "additionalProperties": false, "required": ["artifact_role", "host_path", "guest_path", "mode", "content_sha256"], "properties": { "artifact_role": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "host_path": { "type": "string", "pattern": "^/" }, "guest_path": { "type": "string", "pattern": "^/" }, "mode": { "enum": ["ro", "rw"] }, "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "bytePin": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "schema_sha256"], "properties": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "schema_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "executorSemanticsBundle": { "type": "object", "additionalProperties": false, "required": ["capability_id", "attestation", "attestation_pin", "conformance_receipt", "receipt_pin", "reviewed_predecessor"], "properties": { "capability_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "attestation": { "$ref": "executor-semantics-attestation.schema.v2.json" }, "attestation_pin": { "$ref": "#/$defs/bytePin" }, "conformance_receipt": { "$ref": "executor-conformance-receipt.schema.v2.json" }, "receipt_pin": { "$ref": "#/$defs/bytePin" }, "reviewed_predecessor": { "type": "object", "additionalProperties": false, "required": ["commit", "repository_path"], "properties": { "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "repository_path": { "type": "string", "pattern": "^docs/dataset-factory/authorities/reviewed-metrics-v2/executor-receipts/[a-z0-9._-]+\\.json$" } } } } },
    "identity": { "type": "object", "additionalProperties": false, "required": ["observed_at", "principal", "session_id", "route", "physical_route_identity_sha256"], "properties": { "observed_at": { "type": "string", "format": "date-time" }, "principal": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 }, "route": { "type": "string", "pattern": "^/" }, "physical_route_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "signer": { "type": "object", "additionalProperties": false, "required": ["principal", "session_id", "route", "physical_route_identity_sha256", "public_key_pem", "public_key_sha256"], "properties": { "principal": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 }, "route": { "type": "string", "pattern": "^/" }, "physical_route_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "public_key_pem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" }, "public_key_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  }
}
