{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "installed-dependency-tree.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enumeration_contract", "resolution_contract", "physical_roots", "members", "tree_sha256", "tree_bytes", "member_count"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_installed_dependency_tree_v2.2.0" },
    "enumeration_contract": { "const": "sorted_physical_regular_files_path_sha256_bytes_v2" },
    "resolution_contract": { "$ref": "#/$defs/resolutionContract" },
    "physical_roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/physicalRoot" } },
    "members": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/filePin" } },
    "tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tree_bytes": { "type": "integer", "minimum": 1 },
    "member_count": { "type": "integer", "minimum": 4 }
  },
  "$defs": {
    "filePin": { "type": "object", "additionalProperties": false, "required": ["path", "realpath", "sha256", "bytes", "version"], "properties": { "path": { "type": "string", "pattern": "^/" }, "realpath": { "type": "string", "pattern": "^/" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "physicalRoot": { "type": "object", "additionalProperties": false, "required": ["path", "realpath", "discovery_rule"], "properties": { "path": { "type": "string", "pattern": "^/" }, "realpath": { "type": "string", "pattern": "^/" }, "discovery_rule": { "const": "recursive_regular_files_no_symlinks_v1" } } },
    "moduleEdge": { "type": "object", "additionalProperties": false, "required": ["importer_realpath", "specifier", "resolved_realpath", "resolution_kind"], "properties": { "importer_realpath": { "type": "string", "pattern": "^/" }, "specifier": { "type": "string", "minLength": 1 }, "resolved_realpath": { "type": "string", "pattern": "^/" }, "resolution_kind": { "enum": ["builtin", "file", "package_export", "package_main"] } } },
    "nativeEdge": { "type": "object", "additionalProperties": false, "required": ["consumer_realpath", "soname", "resolved_realpath"], "properties": { "consumer_realpath": { "type": "string", "pattern": "^/" }, "soname": { "type": "string", "minLength": 1 }, "resolved_realpath": { "type": "string", "pattern": "^/" } } },
    "resolutionContract": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "root_derivation", "runtime", "entrypoints", "package_manager", "module_resolution", "native_resolution", "physical_roots", "resolved_member_realpaths", "roots_sha256", "closure_complete", "closure_sha256"],
      "properties": {
        "version": { "const": "gate_h2_runtime_resolution_closure_v1" },
        "root_derivation": { "const": "node_runtime_package_manager_native_resolver_v1" },
        "runtime": { "$ref": "#/$defs/filePin" },
        "entrypoints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/filePin" } },
        "package_manager": { "type": "object", "additionalProperties": false, "required": ["kind", "installed_layout", "lockfile", "package_manifest", "resolved_package_roots", "proof_sha256"], "properties": { "kind": { "const": "npm_lockfile_v3" }, "installed_layout": { "const": "node_modules_v1" }, "lockfile": { "$ref": "#/$defs/filePin" }, "package_manifest": { "$ref": "#/$defs/filePin" }, "resolved_package_roots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/physicalRoot" } }, "proof_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
        "module_resolution": { "type": "object", "additionalProperties": false, "required": ["kind", "dynamic_specifiers", "unresolved_specifiers", "physical_roots", "edges", "proof_sha256"], "properties": { "kind": { "const": "node_cjs_esm_static_plus_runtime_trace_v1" }, "dynamic_specifiers": { "const": "forbidden" }, "unresolved_specifiers": { "type": "array", "maxItems": 0 }, "physical_roots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/physicalRoot" } }, "edges": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/moduleEdge" } }, "proof_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
        "native_resolution": { "type": "object", "additionalProperties": false, "required": ["kind", "runtime_linkage", "unresolved_libraries", "physical_roots", "edges", "proof_sha256"], "properties": { "kind": { "const": "linux_elf_ld_so_closure_v1" }, "runtime_linkage": { "enum": ["static", "dynamic"] }, "unresolved_libraries": { "type": "array", "maxItems": 0 }, "physical_roots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/physicalRoot" } }, "edges": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nativeEdge" } }, "proof_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
        "physical_roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/physicalRoot" } },
        "resolved_member_realpaths": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
        "roots_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "closure_complete": { "const": true },
        "closure_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
