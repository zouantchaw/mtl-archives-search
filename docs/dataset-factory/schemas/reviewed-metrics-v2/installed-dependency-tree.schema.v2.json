{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "installed-dependency-tree.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enumeration_contract", "members", "tree_sha256", "tree_bytes", "member_count"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_installed_dependency_tree_v2.0.0" },
    "enumeration_contract": { "const": "sorted_physical_regular_files_path_sha256_bytes_v1" },
    "members": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/filePin" } },
    "tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tree_bytes": { "type": "integer", "minimum": 1 },
    "member_count": { "type": "integer", "minimum": 2 }
  },
  "$defs": {
    "filePin": { "type": "object", "additionalProperties": false, "required": ["path", "realpath", "sha256", "bytes", "version"], "properties": { "path": { "type": "string", "pattern": "^/" }, "realpath": { "type": "string", "pattern": "^/" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "version": { "type": "string", "minLength": 1 } } }
  }
}
