  },
  "$defs": {"hashBytes": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes"], "properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}}, "pin": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}}, "commitment": {"type": "object", "additionalProperties": false, "required": ["algorithm", "domain", "canonicalization", "value"], "properties": {"algorithm": {"const": "sha256"}, "domain": {"const": "gate-h-v2-search-expected"}, "canonicalization": {"const": "rfc8785-compatible-canonical-json-v1"}, "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "evaluator": {"type": "object", "additionalProperties": false, "required": ["principal", "session_id", "model", "reasoning_effort", "route", "authority_pin"], "properties": {"principal": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "reasoning_effort": {"type": "string", "minLength": 1}, "route": {"type": "string", "minLength": 1}, "authority_pin": {"$ref": "#/$defs/pin"}}}}
