{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "private-score-receipt.schema.v2.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "candidate_id", "task_id", "source_task", "public_bundle", "prediction", "source_search_freeze", "private_detail", "expected_commitment", "evaluator_authority", "pass", "failure_codes", "scored_at", "privacy"],
  "properties": {
    "schema_version": {"const": "reviewed_metrics_private_score_receipt_v2.0.0"}, "status": {"const": "completed_public_receipt"}, "candidate_id": {"const": "dfv0_reviewed_metrics_v2_candidate_20260715"}, "task_id": {"const": "task-7b1d4f0c9a2e6d83"},
    "source_task": {"$ref": "#/$defs/pin"}, "public_bundle": {"$ref": "#/$defs/pin"}, "prediction": {"$ref": "#/$defs/pin"}, "source_search_freeze": {"$ref": "#/$defs/pin"}, "private_detail": {"$ref": "#/$defs/hashBytes"}, "expected_commitment": {"$ref": "#/$defs/commitment"}, "evaluator_authority": {"$ref": "#/$defs/evaluator"},
