{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pre-activation-attestor-admission.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "synthetic", "evidence_kind", "subject", "reviewed_at", "reviewer", "signature_base64"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_pre_activation_attestor_admission_v2.0.0" },
    "status": { "const": "independently_reviewed_and_admitted" },
    "synthetic": { "const": false },
    "evidence_kind": { "enum": ["d1_live", "linux_sandbox", "pre_activation_verifier"] },
    "subject": { "$ref": "#/$defs/identity" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "signature_base64": { "type": "string", "minLength": 80, "maxLength": 100 }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "session_id", "logical_route", "physical_route_identity_sha256", "public_key_sha256"],
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "logical_route": { "type": "string", "pattern": "^/" },
        "physical_route_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "public_key_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "session_id", "logical_route", "physical_route_identity_sha256", "public_key_sha256", "public_key_pem"],
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "logical_route": { "type": "string", "pattern": "^/" },
        "physical_route_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "public_key_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "public_key_pem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" }
      }
    }
  }
}
