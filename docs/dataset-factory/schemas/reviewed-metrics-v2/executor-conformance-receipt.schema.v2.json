{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executor-conformance-receipt.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "synthetic", "production_eligible", "executor_attestation", "capability_id", "test_universe_sha256", "test_results_sha256", "decision", "reviewed_at", "reviewer", "signature_base64"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_executor_conformance_receipt_v2.0.0" },
    "status": { "enum": ["independently_reviewed_conformant", "synthetic_nonproduction_fixture"] },
    "synthetic": { "type": "boolean" }, "production_eligible": { "type": "boolean" },
    "executor_attestation": { "$ref": "#/$defs/bytePin" }, "capability_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "test_universe_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "test_results_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "const": "exact_semantics_and_real_linux_results_conform" }, "reviewed_at": { "type": "string", "format": "date-time" },
    "reviewer": { "$ref": "#/$defs/signer" }, "signature_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "$defs": {
    "bytePin": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes"], "properties": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 } } },
    "signer": { "type": "object", "additionalProperties": false, "required": ["principal", "session_id", "route", "physical_route_identity_sha256", "public_key_pem", "public_key_sha256"], "properties": { "principal": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 }, "route": { "type": "string", "pattern": "^/" }, "physical_route_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "public_key_pem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" }, "public_key_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  }
}
