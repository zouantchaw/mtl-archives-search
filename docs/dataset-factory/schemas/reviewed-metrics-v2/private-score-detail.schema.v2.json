    "evaluator": {"$ref": "#/$defs/evaluator"}, "inputs": {"type": "object", "additionalProperties": false, "required": ["source_task", "public_bundle", "prediction", "source_search_freeze", "private_envelope"], "properties": {"source_task": {"$ref": "#/$defs/pin"}, "public_bundle": {"$ref": "#/$defs/pin"}, "prediction": {"$ref": "#/$defs/pin"}, "source_search_freeze": {"$ref": "#/$defs/pin"}, "private_envelope": {"$ref": "#/$defs/pin"}}},
