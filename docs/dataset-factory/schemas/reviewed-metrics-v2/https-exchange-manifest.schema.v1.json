{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https-exchange-manifest.schema.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_pin", "manifest_id", "candidate_id", "authorization_version", "stage_id", "socket_owner", "raw_network_policy", "exact_exchange_count", "capabilities"],
  "properties": {
    "schema_version": { "const": "gate_h2_https_exchange_manifest_v1.0.0" },
    "schema_pin": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "schema_version"], "properties": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "schema_version": { "const": "gate_h2_https_exchange_manifest_v1.0.0" } } },
    "manifest_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "authorization_version": { "const": "reviewed_metrics_execution_authorization_v2.5.0" },
    "stage_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "socket_owner": { "const": "host_broker" },
    "raw_network_policy": { "const": "deny_all" },
    "exact_exchange_count": { "type": "integer", "minimum": 1, "maximum": 16 },
    "capabilities": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "https-exchange-capability.schema.v1.json" } }
  }
}
