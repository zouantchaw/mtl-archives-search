{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https-exchange-capability.schema.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_pin", "capability_id", "candidate_id", "stage_id", "exchange_ordinal", "purpose", "protocol_pin", "broker_binary", "protocol_schema", "hostname", "port", "path_query", "method", "fixed_headers", "request_artifact", "connect_deadline_ms", "exchange_deadline_ms", "request_byte_cap", "response_byte_cap", "allowed_response_statuses", "allowed_response_media_types", "content_encoding", "raw_response_output_role", "dns_policy", "tls_policy", "redirect_policy", "retry_policy", "auth_policy", "replay_policy"],
  "properties": {
    "schema_version": { "const": "gate_h2_https_exchange_capability_v1.0.0" },
    "schema_pin": { "$ref": "#/$defs/schemaPin" },
    "capability_id": { "$ref": "#/$defs/sha256" },
    "candidate_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "stage_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "exchange_ordinal": { "type": "integer", "minimum": 0 },
    "purpose": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "protocol_pin": { "const": "https_exchange_uds_v1" },
    "broker_binary": { "$ref": "#/$defs/filePin" },
    "protocol_schema": { "$ref": "#/$defs/filePin" },
    "hostname": { "type": "string", "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "port": { "const": 443 },
    "path_query": { "type": "string", "pattern": "^/(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@/%]*)(?:\\?[A-Za-z0-9\\-._~!$'()*+,;=:@/?%&]*)?$" },
    "method": { "enum": ["GET", "POST"] },
    "fixed_headers": { "type": "object", "additionalProperties": false, "required": ["accept", "content_type", "serialization"], "properties": { "accept": { "$ref": "#/$defs/mediaType" }, "content_type": { "$ref": "#/$defs/mediaType" }, "serialization": { "const": "accept: SP value CRLF; content-type: SP value CRLF" } } },
    "request_artifact": { "type": "object", "additionalProperties": false, "required": ["artifact_role", "sha256", "bytes", "media_type"], "properties": { "artifact_role": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 }, "media_type": { "$ref": "#/$defs/mediaType" } } },
    "connect_deadline_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "exchange_deadline_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
    "request_byte_cap": { "type": "integer", "minimum": 0, "maximum": 16777216 },
    "response_byte_cap": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "allowed_response_statuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 200, "maximum": 599 } },
    "allowed_response_media_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/mediaType" } },
    "content_encoding": { "const": "identity" },
    "raw_response_output_role": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "dns_policy": { "type": "object", "additionalProperties": false, "required": ["resolution_owner", "resolve_once_per_exchange", "connect_only_to_resolved_set", "re_resolve_forbidden", "forbidden_ip_ranges", "mixed_allowed_forbidden_answer"], "properties": { "resolution_owner": { "const": "host_broker" }, "resolve_once_per_exchange": { "const": true }, "connect_only_to_resolved_set": { "const": true }, "re_resolve_forbidden": { "const": true }, "forbidden_ip_ranges": { "const": ["unspecified", "loopback", "link_local", "private", "carrier_grade_nat", "documentation", "benchmark", "multicast", "reserved"] }, "mixed_allowed_forbidden_answer": { "const": "reject_entire_exchange" } } },
    "tls_policy": { "type": "object", "additionalProperties": false, "required": ["sni", "hostname_verification", "pkix", "minimum_tls_version", "custom_ca_roots"], "properties": { "sni": { "const": "exact_capability_hostname" }, "hostname_verification": { "const": "exact_capability_hostname" }, "pkix": { "const": "system_trust_store_required" }, "minimum_tls_version": { "const": "TLSv1.3" }, "custom_ca_roots": { "const": "forbidden" } } },
    "redirect_policy": { "const": "forbid_all" },
    "retry_policy": { "const": "no_automatic_retries" },
    "auth_policy": { "type": "object", "additionalProperties": false, "required": ["injection_owner", "scheme", "credential_capability_id", "stage_visibility", "header_name", "insertion_order", "serialization", "collision_policy"], "properties": { "injection_owner": { "const": "host_broker" }, "scheme": { "enum": ["none", "bearer", "api_key_header"] }, "credential_capability_id": { "$ref": "#/$defs/sha256" }, "stage_visibility": { "const": "never" }, "header_name": { "type": ["string", "null"] }, "insertion_order": { "enum": ["no_auth_header", "after_fixed_headers_before_transport_headers"] }, "serialization": { "enum": ["no_auth_header", "lowercase_name_colon_sp_value_crlf"] }, "collision_policy": { "enum": ["not_applicable", "reject_before_serialization"] } }, "allOf": [{ "if": { "properties": { "scheme": { "const": "none" } }, "required": ["scheme"] }, "then": { "properties": { "header_name": { "type": "null" }, "insertion_order": { "const": "no_auth_header" }, "serialization": { "const": "no_auth_header" }, "collision_policy": { "const": "not_applicable" } } } }, { "if": { "properties": { "scheme": { "const": "bearer" } }, "required": ["scheme"] }, "then": { "properties": { "header_name": { "const": "authorization" }, "insertion_order": { "const": "after_fixed_headers_before_transport_headers" }, "serialization": { "const": "lowercase_name_colon_sp_value_crlf" }, "collision_policy": { "const": "reject_before_serialization" } } } }, { "if": { "properties": { "scheme": { "const": "api_key_header" } }, "required": ["scheme"] }, "then": { "properties": { "header_name": { "const": "x-api-key" }, "insertion_order": { "const": "after_fixed_headers_before_transport_headers" }, "serialization": { "const": "lowercase_name_colon_sp_value_crlf" }, "collision_policy": { "const": "reject_before_serialization" } } } }] },
    "replay_policy": { "type": "object", "additionalProperties": false, "required": ["one_run_token", "single_use_handle", "exact_order_enforced", "consume_on_attempt"], "properties": { "one_run_token": { "const": true }, "single_use_handle": { "const": true }, "exact_order_enforced": { "const": true }, "consume_on_attempt": { "const": true } } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mediaType": { "type": "string", "enum": ["application/json"] },
    "filePin": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "version"], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "schemaPin": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "schema_version"], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 }, "schema_version": { "const": "gate_h2_https_exchange_capability_v1.0.0" } } }
  }
}
