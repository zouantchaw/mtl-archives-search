{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"host-route-measurement.schema.v2.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","candidate_commit","authority_hash","role","nonce","surface_inventory_digest","canonical_physical_host_id","requested_root","canonical_root","existing_ancestor","ancestor_device","ancestor_inode","measured_at"],
  "properties":{
    "schema_version":{"const":"reviewed_metrics_host_route_measurement_v2.0.0"},
    "candidate_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "authority_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "role":{"enum":["implementation","predictor","search_predictor","private_evaluator","gold_reviewer","task_reviewer","publisher"]},
    "nonce":{"type":"string","pattern":"^[a-f0-9]{32,128}$"},
    "surface_inventory_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "canonical_physical_host_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "requested_root":{"type":"string","pattern":"^/"},
    "canonical_root":{"type":"string","pattern":"^/"},
    "existing_ancestor":{"type":"string","pattern":"^/"},
    "ancestor_device":{"type":"integer","minimum":0},
    "ancestor_inode":{"type":"integer","minimum":0},
    "measured_at":{"type":"string","format":"date-time"}
  }
}
