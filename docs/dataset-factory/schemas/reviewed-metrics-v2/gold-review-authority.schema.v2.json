{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold-review-authority.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "candidate_id", "bundle_tree_sha256", "reviewer", "reviews", "required_opaque_ids", "reviewed_exclusions", "source_task_dossier_decision", "private_expected_commitment"],
  "properties": {
    "schema_version": {"const": "reviewed_metrics_gold_review_authority_v2.0.0"},
    "status": {"enum": ["blank_external_review_required", "completed"]},
    "candidate_id": {"const": "dfv0_reviewed_metrics_v2_candidate_20260715"},
    "bundle_tree_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "reviewer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reviewer"}]},
    "reviews": {"type": "array", "maxItems": 44, "items": {"$ref": "#/$defs/review"}},
    "required_opaque_ids": {"type": "array", "minItems": 44, "maxItems": 44, "uniqueItems": true, "items": {"type": "string", "pattern": "^v2-[0-9]{4}$"}},
    "reviewed_exclusions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exclusion"}},
    "source_task_dossier_decision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/dossier"}]},
    "private_expected_commitment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/commitment"}]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "blank_external_review_required"}}}, "then": {"properties": {"bundle_tree_sha256": {"type": "null"}, "reviewer": {"type": "null"}, "reviews": {"maxItems": 0}, "reviewed_exclusions": {"maxItems": 0}, "source_task_dossier_decision": {"type": "null"}, "private_expected_commitment": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"bundle_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "reviewer": {"$ref": "#/$defs/reviewer"}, "reviews": {"minItems": 44, "maxItems": 44}, "source_task_dossier_decision": {"$ref": "#/$defs/dossier"}, "private_expected_commitment": {"$ref": "#/$defs/commitment"}}}}
  ],
  "$defs": {
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["identity", "session_id", "model", "reasoning_effort", "reviewed_at", "independence"], "properties": {"identity": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "reasoning_effort": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}, "independence": {"$ref": "#/$defs/independence"}}},
    "independence": {"type": "object", "additionalProperties": false, "required": ["prediction_blind", "no_implementation_overlap", "no_predictor_overlap", "distinct_session"], "properties": {"prediction_blind": {"const": true}, "no_implementation_overlap": {"const": true}, "no_predictor_overlap": {"const": true}, "distinct_session": {"const": true}}},
    "entity": {"type": "object", "additionalProperties": false, "required": ["entity_id", "surface", "bbox", "type", "identity_decision", "supported_identity"], "properties": {"entity_id": {"type": "string", "minLength": 1}, "surface": {"type": "string"}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}, "type": {"enum": ["organization", "brand", "person", "building", "street", "place", "other"]}, "identity_decision": {"enum": ["surface_only", "linked", "abstain"]}, "supported_identity": {"type": ["string", "null"]}}},
    "place": {"type": "object", "additionalProperties": false, "required": ["opportunity_id", "civic_number", "street", "place", "official_url", "supported"], "properties": {"opportunity_id": {"type": "string", "minLength": 1}, "civic_number": {"type": ["string", "null"]}, "street": {"type": ["string", "null"]}, "place": {"type": ["string", "null"]}, "official_url": {"type": ["string", "null"], "format": "uri"}, "supported": {"type": "boolean"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["opaque_id", "image_mode", "ocr_raw", "ocr_normalized", "entities", "place_opportunities", "aerial_reviewable", "aerial_labels", "answerable", "exclusion"], "properties": {"opaque_id": {"type": "string", "pattern": "^v2-[0-9]{4}$"}, "image_mode": {"enum": ["ground_street", "aerial_vertical", "aerial_oblique", "document_map", "low_information", null]}, "ocr_raw": {"type": ["string", "null"]}, "ocr_normalized": {"type": ["string", "null"]}, "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}, "place_opportunities": {"type": "array", "items": {"$ref": "#/$defs/place"}}, "aerial_reviewable": {"type": ["boolean", "null"]}, "aerial_labels": {"type": "array", "uniqueItems": true, "items": {"enum": ["farmland", "residential", "industrial", "rail", "waterfront", "roads", "parks_forest", "mixed_urban", "unreviewable"]}}, "answerable": {"type": ["boolean", "null"]}, "exclusion": {"type": ["string", "null"]}}},
    "exclusion": {"type": "object", "additionalProperties": false, "required": ["opaque_id", "reason", "fixed_before_scoring"], "properties": {"opaque_id": {"type": "string", "pattern": "^v2-[0-9]{4}$"}, "reason": {"type": "string", "minLength": 1}, "fixed_before_scoring": {"const": true}}},
    "dossier": {"type": "object", "additionalProperties": false, "required": ["status", "source_claim_supported", "prediction_blind", "rights_boundary_passed", "no_pixel_identity_claim"], "properties": {"status": {"enum": ["accepted", "held", "rejected"]}, "source_claim_supported": {"type": "boolean"}, "prediction_blind": {"const": true}, "rights_boundary_passed": {"type": "boolean"}, "no_pixel_identity_claim": {"const": true}}},
    "commitment": {"type": "object", "additionalProperties": false, "required": ["algorithm", "domain", "value"], "properties": {"algorithm": {"const": "sha256"}, "domain": {"const": "gate-h-v2-search-expected"}, "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  }
}
