{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-h2-linux-conformance-run-evidence.schema.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "synthetic", "production_eligible", "metadata", "metadata_sha256", "universe_sha256", "results"],
  "properties": {
    "schema_version": { "const": "gate_h2_linux_conformance_run_evidence_v1.0.0" }, "status": { "enum": ["synthetic_local_fixture", "observed_real_linux_conformance"] }, "synthetic": { "type": "boolean" }, "production_eligible": { "type": "boolean" }, "metadata_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "universe_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["predecessor", "source", "builder_image", "admitted_oci_image", "podman", "host", "producer"], "properties": {
      "predecessor": { "$ref": "#/$defs/predecessor" },
      "source": { "$ref": "#/$defs/source" }, "builder_image": { "$ref": "#/$defs/image" }, "admitted_oci_image": { "$ref": "#/$defs/image" }, "podman": { "$ref": "#/$defs/podman" }, "host": { "$ref": "#/$defs/host" }, "producer": { "$ref": "#/$defs/producer" }
    } },
    "results": { "type": "array", "minItems": 69, "maxItems": 69, "items": { "type": "object", "additionalProperties": false, "required": ["case_id", "outcome", "evidence"], "properties": { "case_id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "outcome": { "enum": ["pass", "fail", "skipped"] }, "evidence": { "$ref": "#/$defs/evidence" } } } }
  },
  "$defs": {
    "pin": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 } } },
    "predecessor": { "type": "object", "additionalProperties": false, "required": ["artifact_id", "sorted_tree_sha256", "commit", "pins", "schema_commitments"], "properties": { "artifact_id": { "const": "dfv0_gate_h2_podman_supervisor_v1_20260718" }, "sorted_tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "pins": { "type": "object", "additionalProperties": false, "required": ["podman_descriptor", "https_broker_descriptor", "source_allowlist"], "properties": { "podman_descriptor": { "$ref": "#/$defs/pin" }, "https_broker_descriptor": { "$ref": "#/$defs/pin" }, "source_allowlist": { "$ref": "#/$defs/pin" } } }, "schema_commitments": { "type": "object", "additionalProperties": false, "required": ["podman_descriptor_schema_version", "https_broker_descriptor_schema_version", "inherited_descriptor_sha256"], "properties": { "podman_descriptor_schema_version": { "type": "string" }, "https_broker_descriptor_schema_version": { "type": "string" }, "inherited_descriptor_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["commit", "tree", "source_manifest_sha256"], "properties": { "commit": { "type": "string", "minLength": 1 }, "tree": { "type": "string", "minLength": 1 }, "source_manifest_sha256": { "type": "string", "minLength": 1 } } },
    "image": { "type": "object", "additionalProperties": false, "required": ["reference", "digest"], "properties": { "reference": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "minLength": 1 } } },
    "podman": { "type": "object", "additionalProperties": false, "required": ["executable_pin", "version", "rootless", "rootless_uid"], "properties": { "executable_pin": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 1 } } }, "version": { "type": "string", "minLength": 1 }, "rootless": { "type": "boolean" }, "rootless_uid": { "type": "integer", "minimum": 0 } } },
    "host": { "type": "object", "additionalProperties": false, "required": ["platform", "kernel_release", "architecture"], "properties": { "platform": { "type": "string", "minLength": 1 }, "kernel_release": { "type": "string", "minLength": 1 }, "architecture": { "type": "string", "minLength": 1 } } },
    "producer": { "type": "object", "additionalProperties": false, "required": ["principal", "run_id"], "properties": { "principal": { "type": "string", "minLength": 1 }, "run_id": { "type": "string", "minLength": 1 } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "media_type", "kind", "schema_version"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "media_type": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" }, "kind": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "schema_version": { "const": "v1" } } }
  }
}
