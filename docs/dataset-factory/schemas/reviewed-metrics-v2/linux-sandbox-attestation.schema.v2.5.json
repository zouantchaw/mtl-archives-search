{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "linux-sandbox-attestation.schema.v2.5.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "synthetic", "platform", "wrapper", "image", "runtime_tree", "executor_semantics", "wrapper_grammar_version", "fixed_argument_allowlist", "argv_prefix", "mounts", "network", "writable_confinement", "repo_tree_sha256", "observation", "signer", "signature_base64"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_linux_sandbox_attestation_v2.5.0" },
    "status": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/status" },
    "synthetic": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/synthetic" },
    "platform": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/platform" },
    "wrapper": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/wrapper" },
    "image": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/image" },
    "runtime_tree": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/runtime_tree" },
    "executor_semantics": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["capability_id", "attestation", "attestation_pin", "conformance_receipt", "receipt_pin", "reviewed_predecessor"],
        "properties": {
          "capability_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "attestation": { "$ref": "executor-semantics-attestation.schema.v2.2.json" },
          "attestation_pin": { "$ref": "linux-sandbox-attestation.schema.v2.json#/$defs/bytePin" },
          "conformance_receipt": { "$ref": "executor-conformance-receipt.schema.v2.2.json" },
          "receipt_pin": { "$ref": "linux-sandbox-attestation.schema.v2.json#/$defs/bytePin" },
          "reviewed_predecessor": { "$ref": "linux-sandbox-attestation.schema.v2.json#/$defs/executorSemanticsBundle/properties/reviewed_predecessor" }
        }
      }
    },
    "wrapper_grammar_version": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/wrapper_grammar_version" },
    "fixed_argument_allowlist": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/fixed_argument_allowlist" },
    "argv_prefix": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/argv_prefix" },
    "mounts": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/mounts" },
    "network": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/network" },
    "writable_confinement": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/writable_confinement" },
    "repo_tree_sha256": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/repo_tree_sha256" },
    "observation": { "allOf": [{ "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/observation" }, { "properties": { "observed_at": { "$ref": "#/$defs/canonicalTimestamp" } } }] },
    "signer": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/signer" },
    "signature_base64": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/signature_base64" }
  },
  "$defs": {
    "canonicalTimestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" }
  }
}
