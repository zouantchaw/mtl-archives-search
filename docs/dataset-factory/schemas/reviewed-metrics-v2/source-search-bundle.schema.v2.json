{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-search-bundle.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "task_id", "prompt", "official_domain_policy", "output_schema"],
  "properties": {
    "schema_version": {"const": "reviewed_metrics_source_search_bundle_v2.0.0"},
    "status": {"enum": ["template_no_bundle", "sealed_public_bundle"]},
    "task_id": {"const": "task-7b1d4f0c9a2e6d83"},
    "prompt": {"type": "string", "minLength": 1},
    "official_domain_policy": {"type": "object", "additionalProperties": false, "required": ["scheme", "hostname_suffix"], "properties": {
      "scheme": {"const": "https"},
      "hostname_suffix": {"const": ".gouv.qc.ca"}
    }},
    "output_schema": {"$ref": "#/$defs/nullablePin"}
  },
  "$defs": {
    "pin": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"const": "source-search-output-schema-v2.json"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}},
    "nullablePin": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pin"}]}
  }
}
