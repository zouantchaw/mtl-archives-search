        "conformance_receipt": { "$ref": "executor-conformance-receipt.schema.v2.2.json" },
        "receipt_pin": { "$ref": "linux-sandbox-attestation.schema.v2.json#/$defs/bytePin" },
        "reviewed_predecessor": { "$ref": "linux-sandbox-attestation.schema.v2.json#/$defs/executorSemanticsBundle/properties/reviewed_predecessor" }
      }
    },
    "preActivationAttestationsV25": {
      "type": "object", "additionalProperties": false, "required": ["contract_version", "max_age_seconds", "d1", "sandbox", "verification"],
      "properties": {
        "contract_version": { "const": "gate_h2_pre_activation_attestations_v1" },
        "max_age_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "d1": { "$ref": "execution-authorization.schema.v2.json#/$defs/attestationPin" },
        "sandbox": { "$ref": "#/$defs/sandboxAttestationPinV25" },
        "verification": { "$ref": "execution-authorization.schema.v2.json#/$defs/attestationPin" }
      }
