  "$id": "execution-authorization.schema.v2.5.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "candidate_id", "implementation_base_commit", "candidate_commit", "bundle_tree_sha256", "coordinator_trust", "trusted_surface_inventory", "stage_execution", "pre_activation_attestations", "https_exchange_authority", "implementation", "predictor", "search_predictor", "private_evaluator", "gold_reviewer", "task_reviewer", "publisher", "forbidden_prior_reviewers", "authorized_at", "started_at", "ended_at", "freeze_at", "source_search_started_at", "source_search_ended_at", "source_search_freeze_at", "source_dossier_authored_at", "private_envelope_sealed_at", "expires_at"],
  "properties": {
