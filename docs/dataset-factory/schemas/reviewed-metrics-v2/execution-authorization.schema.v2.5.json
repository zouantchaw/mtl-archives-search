                "artifacts": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/operation/oneOf/1/properties/artifacts" },
                "dependency_lock": { "$ref": "execution-authorization.schema.v2.json#/$defs/filePin" },
                "installed_dependency_tree": { "$ref": "execution-authorization.schema.v2.json#/$defs/filePin" },
                "repo_tree_sha256": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/operation/oneOf/1/properties/repo_tree_sha256" },
                "cwd": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/operation/oneOf/1/properties/cwd" },
                "argv": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/operation/oneOf/1/properties/argv" },
                "argv_bindings": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/operation/oneOf/1/properties/argv_bindings" },
                "declared_output_paths": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/operation/oneOf/1/properties/declared_output_paths" },
                "executor_capability_id": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/operation/oneOf/1/properties/executor_capability_id" },
                "network_policy": { "const": "deny_all" },
                "network_capability_ids": { "type": "array", "maxItems": 0 },
                "environment": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/operation/oneOf/1/properties/environment" }
              }
            }
          ]
        },
        "outputs": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/outputs" }
      }
    },
    "executionBoundaryV25": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "platform", "wrapper", "wrapper_grammar_version", "fixed_argument_allowlist", "argv_prefix", "argv_prefix_bindings", "image_identity_kind", "image_immutable_identity", "image_digest", "resolution_contract", "dependency_tree_sha256", "dependency_tree_bytes", "dependency_tree_members", "executor_semantics", "network_policy", "network_capability_ids", "network_namespace_sha256", "firewall_rules_sha256", "writable_paths", "readable_mounts", "output_mounts", "repo_tree_sha256", "attestation_sha256", "attestation_artifact_sha256"],
      "properties": {
