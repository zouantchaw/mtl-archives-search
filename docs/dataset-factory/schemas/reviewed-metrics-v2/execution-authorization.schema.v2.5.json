    "private_evaluator": { "$ref": "execution-authorization.schema.v2.json#/$defs/privateEvaluatorActor" },
    "gold_reviewer": { "$ref": "execution-authorization.schema.v2.json#/$defs/goldActor" },
    "task_reviewer": { "$ref": "execution-authorization.schema.v2.json#/$defs/taskActor" },
    "publisher": { "$ref": "execution-authorization.schema.v2.json#/$defs/publisherActor" },
