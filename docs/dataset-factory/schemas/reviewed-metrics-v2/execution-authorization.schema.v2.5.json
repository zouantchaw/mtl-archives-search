    "authorized_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "started_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "ended_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "freeze_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "source_search_started_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "source_search_ended_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "source_search_freeze_at": { "$ref": "#/$defs/canonicalTimestamp" },
