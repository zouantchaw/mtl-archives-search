        "invocation_id": { "$ref": "execution-authorization.schema.v2.json#/$defs/stageEntry/properties/invocation_id" },
        "operation": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "builtin" } } },
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "execution_boundary", "runtime", "script", "artifacts", "dependency_lock", "installed_dependency_tree", "repo_tree_sha256", "cwd", "argv", "argv_bindings", "declared_output_paths", "executor_capability_id", "network_policy", "network_capability_ids", "environment"],
              "properties": {
                "kind": { "const": "external_command" },
                "execution_boundary": { "$ref": "#/$defs/executionBoundaryV25" },
                "runtime": { "$ref": "execution-authorization.schema.v2.json#/$defs/filePin" },
