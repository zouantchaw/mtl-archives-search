{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-program.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_sha256", "executor_contract", "action", "capability_id", "input_artifact_roles", "output_indexes", "network_capability_ids"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_stage_program_v2.0.0" },
    "schema_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executor_contract": { "const": "gate_h2_static_stage_program_executor_v1" },
    "action": { "const": "invoke_attested_capability" },
    "capability_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_artifact_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
    "output_indexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "network_capability_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
  }
}
