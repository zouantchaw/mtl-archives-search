{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-authorization.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "candidate_id",
    "implementation_base_commit",
    "candidate_commit",
    "bundle_tree_sha256",
    "implementation",
    "predictor",
    "gold_reviewer",
    "task_reviewer",
    "publisher",
    "forbidden_prior_reviewers",
    "authorized_at",
    "started_at",
    "ended_at",
    "freeze_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "enum": [
      "reviewed_metrics_execution_authorization_v2.0.0",
      "reviewed_metrics_execution_authorization_v2.2.0"
      ]
    },
    "status": { "const": "activated_exact_one_shot" },
    "candidate_id": { "const": "dfv0_reviewed_metrics_v2_candidate_20260715" },
    "implementation_base_commit": {
      "const": "5fe4dfbe51a320a51f1f126b4a2d8cf0722be5dc"
    },
    "candidate_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "bundle_tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "coordinator_trust": { "$ref": "#/$defs/coordinatorTrust" },
    "trusted_surface_inventory": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/surfaceInventory" } },
    "implementation": { "$ref": "#/$defs/implementationActor" },
    "predictor": { "$ref": "#/$defs/predictorActor" },
    "search_predictor": { "$ref": "#/$defs/searchPredictorActor" },
    "private_evaluator": { "$ref": "#/$defs/privateEvaluatorActor" },
    "gold_reviewer": { "$ref": "#/$defs/goldActor" },
    "task_reviewer": { "$ref": "#/$defs/taskActor" },
    "publisher": { "$ref": "#/$defs/publisherActor" },
    "forbidden_prior_reviewers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/forbiddenActor" }
    },
    "authorized_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "freeze_at": { "type": "string", "format": "date-time" },
    "source_search_started_at": { "type": "string", "format": "date-time" },
    "source_search_ended_at": { "type": "string", "format": "date-time" },
    "source_search_freeze_at": { "type": "string", "format": "date-time" },
    "source_dossier_authored_at": { "type": "string", "format": "date-time" },
    "private_envelope_sealed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "reviewed_metrics_execution_authorization_v2.2.0"
          }
        }
      },
      "then": {
        "required": [
          "search_predictor",
          "private_evaluator",
          "source_search_started_at",
          "source_search_ended_at",
          "source_search_freeze_at",
          "source_dossier_authored_at",
          "private_envelope_sealed_at"
          ,"coordinator_trust",
          "trusted_surface_inventory"
        ]
      }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "session_id",
        "model",
        "reasoning_effort",
        "route",
        "surface_id",
        "surface_inventory_digest",
        "route_nonce",
        "route_receipt",
        "canonical_root",
        "role"
      ],
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "surface_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "surface_inventory_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "route_nonce": { "type": "string", "pattern": "^[a-f0-9]{32,128}$" },
        "route_receipt": { "$ref": "#/$defs/routeReceipt" },
        "canonical_root": { "type": "string", "pattern": "^/" },
        "signing_public_key_pem": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----"
        },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "coordinatorTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_key_pem", "public_key_sha256"],
      "properties": {
        "public_key_pem": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----"
        },
        "public_key_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "surfaceInventory": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["inventory_id","kind","canonical_physical_host_id","physical_host_identity","coordinator_signature_base64"],"properties":{"inventory_id":{"type":"string","pattern":"^[a-z0-9_-]+$"},"kind":{"const":"local_host"},"canonical_physical_host_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"physical_host_identity":{"type":"object","additionalProperties":false,"required":["type","hardware_uuid","os_host_evidence_sha256","measured_at","coordinator_verification_pin"],"properties":{"type":{"const":"local_macos"},"hardware_uuid":{"type":"string","pattern":"^[A-Fa-f0-9-]{16,64}$"},"os_host_evidence_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"measured_at":{"type":"string","format":"date-time"},"coordinator_verification_pin":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"coordinator_signature_base64":{"type":"string","minLength":80,"maxLength":100}}},
        {"type":"object","additionalProperties":false,"required":["inventory_id","kind","canonical_physical_host_id","physical_host_identity","coordinator_signature_base64"],"properties":{"inventory_id":{"type":"string","pattern":"^[a-z0-9_-]+$"},"kind":{"const":"remote_host"},"canonical_physical_host_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"physical_host_identity":{"type":"object","additionalProperties":false,"required":["type","identity_document_sha256","identity_signature_pkcs7_sha256","instance_id","account_id","region","image_id","pending_time","coordinator_verification_pin"],"properties":{"type":{"const":"aws_ec2"},"identity_document_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"identity_signature_pkcs7_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"instance_id":{"type":"string","pattern":"^i-[a-f0-9]+$"},"account_id":{"type":"string","pattern":"^[0-9]{12}$"},"region":{"type":"string","pattern":"^[a-z]{2}-[a-z]+-[0-9]+$"},"image_id":{"type":"string","pattern":"^ami-[a-f0-9]+$"},"pending_time":{"type":"string","format":"date-time"},"coordinator_verification_pin":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"coordinator_signature_base64":{"type":"string","minLength":80,"maxLength":100}}}
      ]
    },
    "routeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "surface_id",
        "surface_inventory_digest",
        "canonical_physical_host_id",
        "candidate_commit",
        "authority_hash",
        "nonce",
        "role",
        "requested_root",
        "canonical_root",
        "existing_ancestor",
        "ancestor_device",
        "ancestor_inode",
        "measured_at",
        "measurement_sha256",
        "role_event_started_at",
        "role_event_ended_at",
        "issued_at",
        "expires_at",
        "signature_base64"
      ],
      "properties": {
        "schema_version": {
          "const": "reviewed_metrics_coordinator_route_receipt_v2.0.0"
        },
        "surface_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "surface_inventory_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonical_physical_host_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidate_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "authority_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "nonce": { "type": "string", "pattern": "^[a-f0-9]{32,128}$" },
        "role": { "type": "string", "minLength": 1 },
        "requested_root": { "type": "string", "pattern": "^/" },
        "canonical_root": { "type": "string", "pattern": "^/" },
        "existing_ancestor": { "type": "string", "pattern": "^/" },
        "ancestor_device": { "type": "integer", "minimum": 0 },
        "ancestor_inode": { "type": "integer", "minimum": 0 },
        "measured_at": { "type": "string", "format": "date-time" },
        "measurement_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "role_event_started_at": { "type": "string", "format": "date-time" },
        "role_event_ended_at": { "type": "string", "format": "date-time" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "signature_base64": { "type": "string", "minLength": 1 }
      }
    },
    "implementationActor": {
      "allOf": [
        { "$ref": "#/$defs/actor" },
        { "properties": { "role": { "const": "implementation" } } }
      ]
    },
    "predictorActor": {
      "allOf": [
        { "$ref": "#/$defs/actor" },
        { "properties": { "role": { "const": "predictor" } } }
      ]
    },
    "searchPredictorActor": {
      "allOf": [
        { "$ref": "#/$defs/actor" },
        { "properties": { "role": { "const": "search_predictor" } } }
      ]
    },
    "privateEvaluatorActor": {
      "allOf": [
        { "$ref": "#/$defs/actor" },
        { "properties": { "role": { "const": "private_evaluator" } } }
      ]
    },
    "goldActor": {
      "allOf": [
        { "$ref": "#/$defs/actor" },
        { "properties": { "role": { "const": "gold_reviewer" } } }
      ]
    },
    "taskActor": {
      "allOf": [
        { "$ref": "#/$defs/actor" },
        { "properties": { "role": { "const": "task_reviewer" } } }
      ]
    },
    "publisherActor": {
      "allOf": [
        { "$ref": "#/$defs/actor" },
        { "properties": { "role": { "const": "publisher" } } }
      ]
    },
    "forbiddenActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "session_id", "model", "role"],
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "role": { "const": "forbidden_prior_reviewer" }
      }
    }
  }
}
