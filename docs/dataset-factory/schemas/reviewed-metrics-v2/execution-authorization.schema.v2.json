    },
    "publisherActor": {
      "allOf": [
        { "$ref": "#/$defs/actor" },
        { "properties": { "role": { "const": "publisher" } } }
      ]
    },
    "forbiddenActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "session_id", "model", "role"],
      "properties": {
        "principal": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "role": { "const": "forbidden_prior_reviewer" }
      }
    }
  }
}
