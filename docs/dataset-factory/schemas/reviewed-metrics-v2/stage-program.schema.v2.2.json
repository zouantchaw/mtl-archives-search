{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-program.schema.v2.2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_sha256", "executor_contract", "action", "input_artifact_roles", "output_indexes", "broker_socket_role", "one_run_token_role", "https_exchange_handles"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_stage_program_v2.2.0" },
    "schema_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executor_contract": { "const": "gate_h2_static_stage_program_executor_v2" },
    "action": { "const": "invoke_exact_https_exchange" },
    "input_artifact_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
    "output_indexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "broker_socket_role": { "const": "owner_bound_https_exchange_socket" },
    "one_run_token_role": { "const": "broker_one_run_token" },
    "https_exchange_handles": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^h2h_[A-Za-z0-9_-]{32,86}$" } }
  }
}
