{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executor-conformance-receipt.schema.v2.2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "synthetic", "production_eligible", "executor_attestation", "attestation_schema", "capability_id", "test_universe_sha256", "test_results_sha256", "decision", "reviewed_at", "reviewer", "signature_base64"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_executor_conformance_receipt_v2.2.0" },
    "status": { "enum": ["independently_reviewed_conformant", "synthetic_nonproduction_fixture"] },
    "synthetic": { "type": "boolean" },
    "production_eligible": { "type": "boolean" },
    "executor_attestation": { "$ref": "executor-conformance-receipt.schema.v2.json#/$defs/bytePin" },
    "attestation_schema": { "$ref": "executor-conformance-receipt.schema.v2.json#/$defs/bytePin" },
    "capability_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "test_universe_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "test_results_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "const": "exact_https_exchange_semantics_and_real_linux_results_conform" },
    "reviewed_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "reviewer": { "$ref": "executor-conformance-receipt.schema.v2.json#/$defs/signer" },
    "signature_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "$defs": {
    "canonicalTimestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" }
  }
}
