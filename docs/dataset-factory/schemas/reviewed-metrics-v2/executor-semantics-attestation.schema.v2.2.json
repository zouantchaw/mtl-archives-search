{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executor-semantics-attestation.schema.v2.2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "synthetic", "production_eligible", "capability_derivation", "subject", "test_universe", "test_results", "capability_id", "observation", "signer", "signature_base64"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_executor_semantics_attestation_v2.2.0" },
    "status": { "enum": ["observed_real_linux_conformant", "synthetic_nonproduction_fixture"] },
    "synthetic": { "type": "boolean" },
    "production_eligible": { "type": "boolean" },
    "capability_derivation": { "const": "sha256_domain_gate_h2_executor_semantics_capability_v2_2_canonical_subject_tests" },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["wrapper", "runtime", "executor", "stage_program", "stage_program_schema", "action_semantics", "mount_output_behavior", "loader_contract", "immutable_copy_contract"],
      "properties": {
        "wrapper": { "$ref": "executor-semantics-attestation.schema.v2.json#/$defs/filePin" },
        "runtime": { "$ref": "executor-semantics-attestation.schema.v2.json#/$defs/filePin" },
        "executor": { "$ref": "executor-semantics-attestation.schema.v2.json#/$defs/filePin" },
        "stage_program": { "$ref": "executor-semantics-attestation.schema.v2.json#/$defs/filePin" },
        "stage_program_schema": { "$ref": "executor-semantics-attestation.schema.v2.json#/$defs/bytePin" },
        "action_semantics": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "action", "input_resolution", "output_resolution", "network_resolution", "socket_resolution", "token_resolution", "handle_resolution", "transcript_resolution", "failure_behavior"],
          "properties": {
            "version": { "const": "gate_h2_invoke_exact_https_exchange_semantics_v1" },
            "action": { "const": "invoke_exact_https_exchange" },
            "input_resolution": { "const": "exact_ordered_read_only_artifact_roles_v1" },
            "output_resolution": { "const": "exact_ordered_declared_output_indexes_v1" },
            "network_resolution": { "const": "raw_network_deny_all_host_broker_only_v1" },
            "socket_resolution": { "const": "owner_bound_unix_socket_role_v1" },
            "token_resolution": { "const": "one_run_token_role_never_serialized_v1" },
            "handle_resolution": { "const": "exact_ordered_single_use_opaque_handles_v1" },
            "transcript_resolution": { "const": "commit_raw_response_then_exact_broker_transcript_v1" },
            "failure_behavior": { "const": "nonzero_or_contract_drift_produces_no_accepted_output_or_completion_v1" }
          }
        },
        "mount_output_behavior": { "$ref": "executor-semantics-attestation.schema.v2.json#/properties/subject/properties/mount_output_behavior" },
        "loader_contract": { "$ref": "executor-semantics-attestation.schema.v2.json#/properties/subject/properties/loader_contract" },
        "immutable_copy_contract": { "$ref": "executor-semantics-attestation.schema.v2.json#/properties/subject/properties/immutable_copy_contract" }
      }
    },
    "test_universe": {
      "type": "object", "additionalProperties": false, "required": ["version", "cases", "universe_sha256"],
      "properties": {
        "version": { "const": "gate_h2_real_linux_exact_https_executor_adversarial_universe_v1" },
        "cases": { "type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
        "universe_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "test_results": {
      "type": "object", "additionalProperties": false, "required": ["platform", "immutable_image_digest", "cases", "all_passed", "results_sha256"],
      "properties": {
        "platform": { "const": "linux" },
        "immutable_image_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "cases": { "type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["name", "result", "evidence_sha256"], "properties": { "name": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "result": { "const": "pass" }, "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
        "all_passed": { "const": true },
        "results_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "capability_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observation": { "allOf": [{ "$ref": "executor-semantics-attestation.schema.v2.json#/$defs/observation" }, { "properties": { "observed_at": { "$ref": "#/$defs/canonicalTimestamp" } } }] },
    "signer": { "$ref": "executor-semantics-attestation.schema.v2.json#/$defs/signer" },
    "signature_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "$defs": {
    "canonicalTimestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" }
  }
}
