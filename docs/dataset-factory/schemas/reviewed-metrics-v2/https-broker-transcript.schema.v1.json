{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https-broker-transcript.schema.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_pin", "transcript_id", "manifest_id", "candidate_id", "stage_id", "run_token_commitment", "socket_identity_sha256", "started_at", "ended_at", "expected_exchange_count", "attempted_exchange_count", "completed_exchange_count", "final_outcome", "events"],
  "properties": {
    "schema_version": { "const": "gate_h2_https_broker_transcript_v1.0.0" },
    "schema_pin": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "schema_version"], "properties": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "schema_version": { "const": "gate_h2_https_broker_transcript_v1.0.0" } } },
    "transcript_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifest_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "stage_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "run_token_commitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "socket_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "started_at": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "ended_at": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "expected_exchange_count": { "type": "integer", "minimum": 1 },
    "attempted_exchange_count": { "type": "integer", "minimum": 0 },
    "completed_exchange_count": { "type": "integer", "minimum": 0 },
    "final_outcome": { "enum": ["complete", "failed_closed"] },
    "events": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https-broker-event.schema.v1.json" } }
  }
}
