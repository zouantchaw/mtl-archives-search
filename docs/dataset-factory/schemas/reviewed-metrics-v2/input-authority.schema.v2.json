{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input-authority.schema.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "status",
    "created_at",
    "implementation_base_commit",
    "candidate_commit",
    "inputs",
    "subsets",
    "counts",
    "predecessors",
    "mutations"
  ],
  "properties": {
    "schema_version": {
      "const": "reviewed_metrics_input_authority_v2.0.0"
    },
    "artifact_id": {
      "const": "dfv0_reviewed_metrics_v2_candidate_20260715"
    },
    "status": {
      "const": "fixed_membership_candidate_no_execution_authority"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "implementation_base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "candidate_commit": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{40}$"
    },
    "inputs": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "subsets": {
      "$ref": "#/$defs/subsets"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "predecessors": {
      "$ref": "#/$defs/predecessors"
    },
    "mutations": {
      "$ref": "#/$defs/mutations"
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "width",
        "height",
        "normalized_pixel_sha256",
        "sanitized_normalized_pixel_sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "normalized_pixel_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sanitized_normalized_pixel_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_id",
        "attribution",
        "commercial_use_allowed",
        "complete"
      ],
      "properties": {
        "license_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "commercial_use_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "complete": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "v1_task_id",
            "v1_task_sha256"
          ]
        },
        {
          "required": [
            "phase_d_row_sha256",
            "registered_artifact_id"
          ]
        },
        {
          "required": [
            "ground_input_sha256",
            "ground_records_sha256",
            "reviewed_visual_transcriptions_sha256",
            "neutral_crop_id",
            "parent_neutral_id",
            "numeric_id",
            "region_id"
          ]
        },
        {
          "required": [
            "ground_input_sha256",
            "ground_records_sha256",
            "neutral_scene_id",
            "numeric_id"
          ]
        }
      ],
      "properties": {
        "v1_task_id": {
          "type": "string"
        },
        "v1_task_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "phase_d_row_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registered_artifact_id": {
          "type": "string"
        },
        "ground_input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ground_records_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewed_visual_transcriptions_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "parent_neutral_id": {"type": "string", "minLength": 1},
        "numeric_id": {"type": "integer", "minimum": 0},
        "region_id": {"type": "string", "minLength": 1},
        "neutral_crop_id": {
          "type": "string"
        },
        "neutral_scene_id": {
          "type": "string"
        }
      }
    },
    "predecessors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_d",
        "v1_tasks",
        "v1_receipt",
        "v1_descriptor",
        "gate_e_promotion",
        "gate_f_review",
        "gate_g_descriptor",
        "ground_input"
        ,"ground_records"
        ,"reviewed_visual_transcriptions"
      ],
      "properties": {
        "phase_d": {
          "$ref": "#/$defs/pin"
        },
        "v1_tasks": {
          "$ref": "#/$defs/pin"
        },
        "v1_receipt": {
          "$ref": "#/$defs/pin"
        },
        "v1_descriptor": {
          "$ref": "#/$defs/pin"
        },
        "gate_e_promotion": {
          "$ref": "#/$defs/pin"
        },
        "gate_f_review": {
          "$ref": "#/$defs/pin"
        },
        "gate_g_descriptor": {
          "$ref": "#/$defs/pin"
        },
        "ground_input": {
          "$ref": "#/$defs/pin"
        },
        "ground_records": {
          "$ref": "#/$defs/pin"
        },
        "reviewed_visual_transcriptions": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_id",
        "source_key",
        "source_ref",
        "source",
        "component_id",
        "split",
        "rights",
        "predecessor",
        "purposes"
      ],
      "properties": {
        "opaque_id": {
          "type": "string",
          "pattern": "^v2-[0-9]{4}$"
        },
        "source_key": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ]
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "predecessor": {
          "$ref": "#/$defs/predecessor"
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "image_mode",
              "ocr",
              "entity_place",
              "aerial_land_use",
              "abstention"
            ]
          }
        }
      }
    },
    "subsets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_mode",
        "ocr",
        "entity_place",
        "aerial_land_use",
        "abstention"
      ],
      "properties": {
        "image_mode": {
          "type": "array",
          "minItems": 36,
          "maxItems": 36,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "ocr": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "entity_place": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "aerial_land_use": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "abstention": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_sources",
        "task_memberships",
        "image_mode",
        "ocr",
        "entity_place",
        "aerial_land_use",
        "abstention"
      ],
      "properties": {
        "unique_sources": {
          "const": 44
        },
        "task_memberships": {
          "const": 78
        },
        "image_mode": {
          "const": 36
        },
        "ocr": {
          "const": 2
        },
        "entity_place": {
          "const": 6
        },
        "aerial_land_use": {
          "const": 16
        },
        "abstention": {
          "const": 18
        }
      }
    },
    "mutations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production",
        "search_index",
        "private_object_store_write",
        "paid_gpu"
      ],
      "properties": {
        "production": {
          "const": false
        },
        "search_index": {
          "const": false
        },
        "private_object_store_write": {
          "const": false
        },
        "paid_gpu": {
          "const": false
        }
      }
    }
  }
}
