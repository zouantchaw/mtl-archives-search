{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "linux-sandbox-attestation.schema.v2.4.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "synthetic", "platform", "wrapper", "image", "runtime_tree", "executor_semantics", "wrapper_grammar_version", "fixed_argument_allowlist", "argv_prefix", "mounts", "network", "writable_confinement", "runtime_observation", "repo_tree_sha256", "observation", "signer", "signature_base64"],
  "properties": {
    "schema_version": { "const": "reviewed_metrics_linux_sandbox_attestation_v2.4.0" },
    "status": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/status" },
    "synthetic": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/synthetic" },
    "platform": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/platform" },
    "wrapper": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/wrapper" },
    "image": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/image" },
    "runtime_tree": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/runtime_tree" },
    "executor_semantics": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["capability_id", "attestation", "attestation_pin", "conformance_receipt", "receipt_pin", "reviewed_predecessor"],
        "properties": {
          "capability_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "attestation": { "$ref": "executor-semantics-attestation.schema.v2.json" },
          "attestation_pin": { "$ref": "linux-sandbox-attestation.schema.v2.json#/$defs/bytePin" },
          "conformance_receipt": { "$ref": "executor-conformance-receipt.schema.v2.json" },
          "receipt_pin": { "$ref": "linux-sandbox-attestation.schema.v2.json#/$defs/bytePin" },
          "reviewed_predecessor": { "$ref": "linux-sandbox-attestation.schema.v2.json#/$defs/executorSemanticsBundle/properties/reviewed_predecessor" }
        }
      }
    },
    "wrapper_grammar_version": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/wrapper_grammar_version" },
    "fixed_argument_allowlist": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/fixed_argument_allowlist" },
    "argv_prefix": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/argv_prefix" },
    "mounts": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/mounts" },
    "network": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/network" },
    "writable_confinement": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/writable_confinement" },
    "repo_tree_sha256": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/repo_tree_sha256" },
    "runtime_observation": { "$ref": "#/$defs/runtimeObservation" },
    "observation": { "allOf": [{ "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/observation" }, { "properties": { "observed_at": { "$ref": "#/$defs/canonicalTimestamp" } } }] },
    "signer": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/signer" },
    "signature_base64": { "$ref": "linux-sandbox-attestation.schema.v2.json#/properties/signature_base64" }
  },
  "$defs": {
    "canonicalTimestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "runtimeObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "image_manifest_sha256", "image_manifest_bytes", "container_identity_sha256", "process_identity_sha256", "mount_table_sha256", "command_count", "commands", "commands_sha256"],
      "properties": {
        "contract": { "const": "fixed_usr_bin_podman_digest_pinned_v2" },
        "image_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "image_manifest_bytes": { "type": "integer", "minimum": 1 },
        "container_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "process_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mount_table_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "command_count": { "type": "integer", "minimum": 25, "maximum": 64 },
        "commands_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "commands": { "type": "array", "minItems": 25, "maxItems": 64, "items": { "$ref": "#/$defs/commandObservation" } }
      }
    },
    "commandObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "executable", "argv", "started_at", "ended_at", "exit_status", "signal", "timed_out", "stdout_base64", "stdout_sha256", "stdout_bytes", "stderr_base64", "stderr_sha256", "stderr_bytes"],
      "properties": {
        "id": { "type": "string", "enum": ["image_inspect", "container_start", "container_inspect", "copy_wrapper", "copy_runtime", "copy_stage_program", "runtime_self_check", "network_namespace", "mount_table", "firewall_rules", "observed_destinations", "probe_read_only_input_write", "probe_root_write", "probe_undeclared_write", "probe_declared_output_write", "probe_network_denial", "probe_network_allowlist", "executor_canonical_program_success", "executor_program_substitution", "executor_schema_substitution", "executor_executor_substitution", "executor_undeclared_dependency_rejected", "executor_module_loader_absent", "executor_native_loader_absent", "executor_output_never_readable", "executor_undeclared_write_rejected", "executor_network_escape_rejected", "executor_postspawn_source_replacement", "executor_cleanup_precedes_completion", "container_remove", "container_absence"] }, "executable": { "type": "string", "enum": ["/usr/bin/podman", "/usr/bin/readlink", "/usr/bin/cat", "/usr/bin/nsenter", "/usr/sbin/nft", "/usr/bin/ss"] }, "argv": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 4096 } },
        "started_at": { "$ref": "#/$defs/canonicalTimestamp" }, "ended_at": { "$ref": "#/$defs/canonicalTimestamp" }, "exit_status": { "type": ["integer", "null"] }, "signal": { "type": ["string", "null"] }, "timed_out": { "const": false },
        "stdout_base64": { "type": "string", "maxLength": 87384 }, "stdout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "stdout_bytes": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "stderr_base64": { "type": "string", "maxLength": 87384 }, "stderr_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "stderr_bytes": { "type": "integer", "minimum": 0, "maximum": 65536 }
      }
    }
  }
}
