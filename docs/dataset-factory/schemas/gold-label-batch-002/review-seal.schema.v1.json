{
  "$schema":"http://json-schema.org/draft-07/schema#","$id":"https://mtlarchives.com/schemas/gold-label-review-seal-v1.json","type":"object","additionalProperties":false,
  "required":["schema_version","pass","reviewer_ids","status","rows","labels_sha256","packet_manifest_sha256","review_schema_sha256","sealed_at"],
  "properties":{"schema_version":{"const":"gold_label_review_seal_v1.0.0"},"pass":{"enum":["primary","blind"]},"reviewer_ids":{"type":"array","items":{"type":"string","minLength":3},"uniqueItems":true},"status":{"enum":["not_started","sealed"]},"rows":{"type":"integer","minimum":0,"maximum":300},"labels_sha256":{"pattern":"^[a-f0-9]{64}$"},"packet_manifest_sha256":{"pattern":"^[a-f0-9]{64}$"},"review_schema_sha256":{"pattern":"^[a-f0-9]{64}$"},"sealed_at":{"type":["string","null"],"format":"date-time"}},
  "allOf":[{"if":{"properties":{"status":{"const":"not_started"}}},"then":{"properties":{"rows":{"const":0},"reviewer_ids":{"maxItems":0},"sealed_at":{"type":"null"}}}},{"if":{"properties":{"status":{"const":"sealed"}}},"then":{"properties":{"rows":{"const":300},"reviewer_ids":{"minItems":1},"sealed_at":{"type":"string","format":"date-time"}}}}]
}
