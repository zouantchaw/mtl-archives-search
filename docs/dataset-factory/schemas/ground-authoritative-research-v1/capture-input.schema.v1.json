            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 255
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
