        },
        "matched_concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "rejection_reason": {
          "enum": [
            "destination_not_allowlisted",
            "sensitive_destination",
            "missing_location",
            "malformed_location",
            "non_https",
            "credentials",
            "fragment"
