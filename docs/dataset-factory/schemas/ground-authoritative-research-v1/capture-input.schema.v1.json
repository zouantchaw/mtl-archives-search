        "outcome": {
          "enum": [
            "captured_marker_matched",
            "marker_incomplete",
            "captured_transport_only",
            "manual_transport_observed",
            "redirect_rejected",
            "dynamic_or_hcaptcha",
            "network_failure",
            "http_failure",
            "unexpected_content_type",
            "not_requested"
          ]
        },
        "effective_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "observed_location": {
