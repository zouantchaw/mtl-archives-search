{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtl-archives.local/capture-input.schema.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "authoring_sha256",
    "capture_policy",
    "receipts"
  ],
  "properties": {
    "schema_version": {
      "const": "ground_authoritative_research_v1.5.0"
    },
    "artifact_id": {
      "const": "ground-authoritative-research-v1"
    },
    "authoring_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capture_policy": {
      "const": "exact_allowlisted_public_get_no_redirect_follow"
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    }
  },
  "$defs": {
    "observedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "origin_sha256",
        "hostname_label_count",
        "path_segment_count",
        "path_sha256",
        "query_names",
        "query_policy",
        "allowlisted_for_follow"
      ],
      "properties": {
        "scheme": {
          "const": "https"
        },
        "origin_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hostname_label_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "path_segment_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "path_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "query_names": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~-]{1,128}$"
          }
        },
        "query_policy": {
          "const": "names_only_values_redacted"
        },
        "allowlisted_for_follow": {
          "const": false
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_mode",
        "source_policy",
        "expected_marker_count",
        "expected_marker_digest",
        "matched_marker_count",
        "marker_match_state",
        "method",
        "status",
        "content_type",
        "bytes",
        "sha256",
        "retrieved_at",
        "outcome",
        "effective_url",
        "matched_concepts"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_mode": {
          "enum": [
            "manual_bounded_transcription",
            "online_marker_required",
            "online_transport_context",
            "predecessor_metadata",
            "lead_only"
          ]
        },
        "source_policy": {
          "enum": [
            "manual_locator_only",
            "markers_required",
            "transport_only_not_evidence",
            "predecessor_hash_bound",
            "lead_only"
          ]
        },
        "expected_marker_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "expected_marker_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "matched_marker_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "marker_match_state": {
          "enum": [
            "none",
            "partial",
            "complete"
          ]
        },
        "method": {
          "enum": [
            "GET",
            "not_requested"
          ]
        },
        "status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
