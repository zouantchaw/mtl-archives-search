        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "input": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "type": "object",
          "properties": {
            "path": { "const": "independent-review-input-v1.json" },
            "sha256": {
              "const": "c263eef97d3cd1662954a50748b3f9fadab5cf65ff79ac33ba80b909969699b3"
            },
            "bytes": { "const": 2470 }
