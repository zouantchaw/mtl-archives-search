{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reviewer_id",
    "review_session_id",
    "scenes_reviewed",
    "crops_reviewed",
    "corrected_transcriptions",
    "identity_claims",
    "external_claims",
    "fully_verified_dossiers",
    "tasks",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "ground_originals_independent_review_publication_manifest_v1.0.0"
    },
    "status": { "const": "published_verified_external_independent_review" },
    "reviewer_id": { "const": "independent-reviewer-pixel-ocr-v1" },
    "review_session_id": { "const": "independent-session-20260713-ground-v1" },
    "scenes_reviewed": { "const": 6 },
    "crops_reviewed": { "const": 2 },
    "corrected_transcriptions": { "const": 2 },
    "identity_claims": { "const": 0 },
    "external_claims": { "const": 0 },
    "fully_verified_dossiers": { "const": 0 },
    "tasks": { "const": 0 },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/input" },
        { "$ref": "#/$defs/decisions" },
        { "$ref": "#/$defs/seal" },
        { "$ref": "#/$defs/transcriptions" },
