  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_sha256",
    "decisions_sha256",
    "decision_seal_sha256",
    "reviewer_id",
    "review_session_id",
    "identity_claims",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "ground_originals_reviewed_visual_transcriptions_v1.0.0"
    },
    "input_sha256": {
      "const": "c263eef97d3cd1662954a50748b3f9fadab5cf65ff79ac33ba80b909969699b3"
    },
    "decisions_sha256": {
      "const": "32d85f7815a2ef583e36e988ed330347198db056de04f3fa60bd4e42414c536f"
