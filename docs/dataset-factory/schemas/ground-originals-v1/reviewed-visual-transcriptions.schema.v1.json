    "reviewer_id": { "const": "independent-reviewer-pixel-ocr-v1" },
    "review_session_id": { "const": "independent-session-20260713-ground-v1" },
    "identity_claims": { "const": 0 },
    "rows": {
      "type": "array",
      "minItems": 2,
