        "identity_status": { "const": "not_asserted" }
      }
    },
    "first": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "neutral_crop_id": { "const": "ground-crop-01" },
            "literal_text": {
              "const": "WHITE ROSE\nGASOLINE\nTHE PICK OF THEM ALL"
