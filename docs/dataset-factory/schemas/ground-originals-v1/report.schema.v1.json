{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "originals",
    "external_claims",
    "identity_claims",
    "fully_verified_dossiers",
    "tasks",
    "pixel_decisions",
    "ocr_decisions",
    "independent_review"
  ],
  "properties": {
    "schema_version": { "const": "ground_originals_v1.0.0" },
    "originals": { "const": 6 },
    "external_claims": { "const": 0 },
    "identity_claims": { "const": 0 },
    "fully_verified_dossiers": { "const": 0 },
    "tasks": { "const": 0 },
    "pixel_decisions": {
      "enum": ["pending_separate_agent", "sealed_external_independent_review"]
    },
    "ocr_decisions": {
      "enum": ["pending_separate_agent", "two_corrected_visual_transcriptions"]
    },
    "independent_review": {
      "oneOf": [
        { "const": null },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_sha256",
            "decisions_sha256",
            "decision_seal_sha256",
            "reviewer_id",
            "review_session_id",
            "scenes_reviewed",
            "crops_reviewed",
            "corrected_transcriptions",
            "raw_ocr_comparison"
          ],
          "properties": {
            "input_sha256": {
              "const": "c263eef97d3cd1662954a50748b3f9fadab5cf65ff79ac33ba80b909969699b3"
            },
            "decisions_sha256": {
              "const": "32d85f7815a2ef583e36e988ed330347198db056de04f3fa60bd4e42414c536f"
            },
            "decision_seal_sha256": {
              "const": "fb3892870778ac9a683cada3187190fdd643992987436a2b7623a2b2cf4e3ff6"
            },
            "reviewer_id": { "const": "independent-reviewer-pixel-ocr-v1" },
            "review_session_id": {
              "const": "independent-session-20260713-ground-v1"
            },
            "scenes_reviewed": { "const": 6 },
            "crops_reviewed": { "const": 2 },
            "corrected_transcriptions": { "const": 2 },
            "raw_ocr_comparison": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {
                "value": { "const": null },
                "reason": {
                  "const": "No original-frame machine OCR proposals intersect either reviewed crop."
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "independent_review": { "const": null } },
        "required": ["independent_review"]
      },
      "then": {
        "properties": {
          "pixel_decisions": { "const": "pending_separate_agent" },
          "ocr_decisions": { "const": "pending_separate_agent" }
        }
      },
      "else": {
        "properties": {
          "pixel_decisions": { "const": "sealed_external_independent_review" },
          "ocr_decisions": { "const": "two_corrected_visual_transcriptions" }
        }
      }
    }
  ]
}
