{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtlarchives.com/schemas/real-pilot-candidate-selection-v1/candidate.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "record_id", "numeric_id", "declared_anchor", "anchor_note", "lane", "rank", "selection_bucket", "proxy_score", "proxy_markers", "proxy_boundary", "verified_claim_count", "title", "description", "date", "cote", "component_id", "component_size", "benchmark_split", "source_identity_sha256", "derivative", "payload_identities", "rights", "source"],
  "properties": {
    "schema_version": { "const": "verified_multimodal_real_pilot_candidate_selection_v1.0.0" },
    "candidate_id": { "type": "string", "pattern": "^real-pilot-candidate:[a-f0-9]{24}$" },
    "record_id": { "type": "string", "pattern": "^mtl_archives_metadata_[0-9]+\\.json$" },
    "numeric_id": { "type": "integer", "minimum": 0 },
    "declared_anchor": { "type": "boolean" },
    "anchor_note": { "type": ["string", "null"] },
    "lane": { "enum": ["ground_ocr_entity_place", "aerial_land_use_georeference"] },
    "rank": { "type": "integer", "minimum": 1 },
    "selection_bucket": { "enum": ["ranked_pool", "reserve"] },
    "proxy_score": { "type": "number" },
    "proxy_markers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "proxy_boundary": { "const": "ranking_only_not_verified" },
    "verified_claim_count": { "const": 0 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "date": { "type": ["string", "null"] },
    "cote": { "type": ["string", "null"] },
    "component_id": { "type": "string", "minLength": 1 },
    "component_size": { "type": "integer", "minimum": 1 },
    "benchmark_split": { "enum": ["train", "validation", "test"] },
    "source_identity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "derivative": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "width", "height"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
    "payload_identities": { "type": "object", "additionalProperties": false, "required": ["normalized_pixel_sha256", "recovered_payload_sha256"], "properties": { "normalized_pixel_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "recovered_payload_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" } } },
    "rights": { "type": "object", "additionalProperties": false, "required": ["complete", "attribution"], "properties": { "complete": { "const": true }, "attribution": { "type": "string", "minLength": 1 } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["policy", "original_identity", "normalized_identity", "original_urls", "normalized_urls"], "properties": { "policy": { "const": "stable_https_or_vetted_depot_https_normalization_not_verified" }, "original_identity": { "type": "string", "minLength": 1 }, "normalized_identity": { "type": "string", "format": "uri", "pattern": "^https://" }, "original_urls": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "normalized_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri", "pattern": "^https://" } } } }
  }
}
