{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "sealed_inputs_sha256",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "ground_claim_adjudication_v1.0.0"
    },
    "artifact_id": {
      "const": "ground-claim-adjudication-v1"
    },
    "sealed_inputs_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "claims": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "record_id",
          "claim_text",
          "evidence_boundary",
          "alternatives_and_limits",
          "visual_reference",
          "sources"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "enum": [
              0,
              10,
              100,
              101,
              102,
              105
            ]
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_boundary": {
            "type": "string",
            "minLength": 1
          },
          "alternatives_and_limits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "visual_reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "artifact_path",
              "region_ids",
              "note"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "none",
                  "whole_image",
                  "regions"
                ]
              },
              "artifact_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "region_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "relationship",
                "family_id",
                "family_label",
                "independence",
                "url",
                "authority_tier",
                "evidence_status",
                "source_note",
                "proposition",
                "limitation",
                "rights_policy"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "relationship": {
                  "enum": [
                    "supporting",
                    "opposing"
                  ]
                },
                "family_id": {
                  "type": "string",
                  "minLength": 1
                },
                "family_label": {
                  "type": "string",
                  "minLength": 1
                },
                "independence": {
                "enum": [
                  "independent",
                  "family_limited"
                ]
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "authority_tier": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_status": {
                  "enum": [
                    "manual_unreviewed",
                    "predecessor_metadata_unreviewed",
                    "content_marker_matched_pending_review"
                  ]
                },
                "source_note": {
                  "type": "string",
                  "minLength": 1
                },
                "proposition": {
                  "type": "string",
                  "minLength": 1
                },
                "limitation": {
                  "type": "string",
                  "minLength": 1
                },
                "rights_policy": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
