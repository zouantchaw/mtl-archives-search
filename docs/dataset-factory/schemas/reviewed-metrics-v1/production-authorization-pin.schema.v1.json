{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "const": "docs/dataset-factory/authorities/reviewed-metrics-v1/reviewer-authorization-v1.json"
        },
        "sha256": { "$ref": "#/$defs/sha" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "reviewer": {
      "$ref": "reviewer-authorization.schema.v1.json#/properties/approved_reviewer"
    },
    "authority": {
      "$ref": "reviewer-authorization.schema.v1.json#/properties/authorizing_authority"
    },
    "output": {
      "$ref": "reviewer-authorization-template.schema.v1.json#/$defs/output"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_id",
    "state",
    "candidate_artifact_id",
    "candidate_descriptor_sha256",
    "authorization_file",
    "approved_reviewer",
    "authorizing_authority",
    "authorized_at",
    "permitted_output",
    "scope_note"
  ],
  "properties": {
    "schema_version": {
      "const": "reviewed_metrics_production_authorization_pin_v1.0.0"
    },
    "authority_id": { "const": "gate-h-production-authorization-pin" },
    "state": { "enum": ["unconfigured", "active"] },
    "candidate_artifact_id": {
      "const": "dfv0_reviewed_metrics_v1_candidate_20260714"
    },
    "candidate_descriptor_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }]
    },
    "authorization_file": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/file" }]
    },
    "approved_reviewer": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reviewer" }]
    },
    "authorizing_authority": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/authority" }]
    },
    "authorized_at": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    },
    "permitted_output": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/output" }]
    },
    "scope_note": { "type": "string", "minLength": 40 }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "unconfigured" } } },
      "then": {
        "properties": {
          "candidate_descriptor_sha256": { "type": "null" },
          "authorization_file": { "type": "null" },
          "approved_reviewer": { "type": "null" },
          "authorizing_authority": { "type": "null" },
          "authorized_at": { "type": "null" },
          "permitted_output": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "active" } } },
      "then": {
        "properties": {
          "candidate_descriptor_sha256": { "$ref": "#/$defs/sha" },
          "authorization_file": { "$ref": "#/$defs/file" },
          "approved_reviewer": { "$ref": "#/$defs/reviewer" },
          "authorizing_authority": { "$ref": "#/$defs/authority" },
          "authorized_at": { "type": "string", "format": "date-time" },
          "permitted_output": { "$ref": "#/$defs/output" }
        }
      }
    }
  ]
}
