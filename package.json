{
  "name": "mtl-archives-search-monorepo",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Semantic and visual search for Montreal city archives.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run deploy --workspace=apps/api",
    "smoke:game": "npm run smoke:game --workspace=apps/next-app --",
    "smoke:game:prod": "npm run smoke:game:prod --workspace=apps/next-app",
    "social:today": "python3 pipelines/daily-reel/main.py",
    "social:publish-story": "python3 pipelines/daily-reel/story_publish.py publish",
    "social:publish-post": "python3 pipelines/daily-reel/post_publish.py",
    "social:token-status": "python3 pipelines/daily-reel/token_manager.py status",
    "story:render": "npm run render --workspace=apps/story-video --",
    "story:today": "npm run render:today --workspace=apps/story-video --"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wrangler": "^4.53.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=23.5.0"
  },
  "author": "zouantchaw",
  "license": "MIT"
}
