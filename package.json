{
  "name": "mtl-archives-search-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "Semantic and visual search for Montreal city archives.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run deploy --workspace=apps/api",
    "clean": "npm run clean --workspace=@mtl-archives/scripts",
    "canonicalize": "npm run canonicalize --workspace=@mtl-archives/scripts",
    "normalize-dates": "npm run normalize-dates --workspace=@mtl-archives/scripts",
    "link-records": "npm run link-records --workspace=@mtl-archives/scripts",
    "link-records:report": "npm run link-records:report --workspace=@mtl-archives/scripts",
    "vlm:tags": "npm run vlm:tags --workspace=@mtl-archives/scripts",
    "merge-vision": "npm run merge-vision --workspace=@mtl-archives/scripts",
    "ocr:run": "python3 pipelines/ocr/ocr-images.py",
    "apply-aerial": "npm run apply-aerial --workspace=@mtl-archives/scripts",
    "merge-enrichments": "npm run merge-enrichments --workspace=@mtl-archives/scripts",
    "score-trust": "npm run score-trust --workspace=@mtl-archives/scripts",
    "open-data:fetch": "npm run open-data:fetch --workspace=@mtl-archives/scripts",
    "open-data:match": "npm run open-data:match --workspace=@mtl-archives/scripts",
    "manifest:dedupe": "npm run manifest:dedupe --workspace=@mtl-archives/scripts",
    "open-data:missing": "npm run open-data:missing --workspace=@mtl-archives/scripts",
    "open-data:ingest-missing": "npm run open-data:ingest-missing --workspace=@mtl-archives/scripts",
    "vectorize:clip": "npm run vectorize:clip --workspace=@mtl-archives/scripts",
    "vectorize:clip:photos": "npm run vectorize:clip:photos --workspace=@mtl-archives/scripts",
    "vectorize:text": "npm run vectorize:text --workspace=@mtl-archives/scripts",
    "vectorize:text:photos": "npm run vectorize:text:photos --workspace=@mtl-archives/scripts",
    "vectorize:status": "npm run vectorize:status --workspace=@mtl-archives/scripts",
    "smoke:pipeline": "npm run smoke:pipeline --workspace=@mtl-archives/scripts",
    "search-quality:audit": "npm run search-quality:audit --workspace=@mtl-archives/scripts",
    "image-artifacts:audit": "npm run image-artifacts:audit --workspace=@mtl-archives/scripts",
    "image-dedupe:audit": "npm run image-dedupe:audit --workspace=@mtl-archives/scripts",
    "vectorize:export": "npm run vectorize:export --workspace=@mtl-archives/scripts",
    "db:generate": "npm run db:generate --workspace=@mtl-archives/scripts",
    "vlm:merge": "node node_modules/tsx/dist/cli.mjs packages/scripts/src/vlm/merge-captions.ts",
    "smoke:game": "npm run smoke:game --workspace=apps/next-app --",
    "smoke:game:prod": "npm run smoke:game:prod --workspace=apps/next-app",
    "smoke:filters": "npm run smoke:filters --workspace=apps/next-app --",
    "smoke:filters:prod": "npm run smoke:filters:prod --workspace=apps/next-app",
    "smoke:filters:mobile": "npm run smoke:filters:mobile --workspace=apps/next-app --",
    "smoke:filters:mobile:prod": "npm run smoke:filters:mobile:prod --workspace=apps/next-app",
    "social:fallback": "python3 pipelines/daily-reel/main.py",
    "social:promote-story": "python3 pipelines/daily-reel/story_pages.py",
    "social:register-publish": "python3 pipelines/daily-reel/publish_registry.py",
    "social:token-bootstrap": "python3 pipelines/daily-reel/token_manager.py bootstrap",
    "social:token-status": "python3 pipelines/daily-reel/token_manager.py status"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wrangler": "^4.53.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=23.5.0"
  },
  "author": "zouantchaw",
  "license": "MIT"
}
